---
interface Props {
  title: string;
  description: string;
  href: string;
  image: string;
  imageAlt: string;
  desk: string;
  evidenceLabel: string;
  evidenceHref: string;
  readingTime: string;
}

const {
  title,
  description,
  href,
  image,
  imageAlt,
  desk,
  evidenceLabel,
  evidenceHref,
  readingTime,
} = Astro.props;
---

<section class="home-hero" aria-labelledby="home-hero-title">
  <div class="home-hero-copy">
    <p class="desk">{desk}</p>
    <h1 id="home-hero-title">
      <a href={href}>{title}</a>
    </h1>
    <p class="deck">{description}</p>
    <p class="hero-meta">
      <a href={evidenceHref}>{evidenceLabel}</a>
      <span class="dot" aria-hidden="true">
        ·
      </span>
      <span>{readingTime}</span>
    </p>
  </div>
  <div class="home-hero-media">
    <img src={image} alt={imageAlt} loading="eager" />
  </div>
</section>

<style>
  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 11fr) minmax(0, 9fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: center;
    padding: 1.5rem 0 2.75rem;
  }
  .home-hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .desk {
    margin: 0;
    color: var(--terracotta);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  h1 {
    margin: 1rem 0 1.25rem;
    font:
      400 clamp(2.2rem, 3.6vw, 3.3rem) / 1.05 Georgia,
      'Times New Roman',
      serif;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  h1 a {
    text-decoration: none;
  }
  h1 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.14em;
  }
  .deck {
    max-width: 38rem;
    margin: 0 0 1.25rem;
    color: var(--muted);
    font: clamp(1.05rem, 1.5vw, 1.25rem) / 1.42 var(--font-deck);
  }
  .hero-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0;
    color: var(--muted);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .hero-meta a {
    color: inherit;
    text-underline-offset: 0.2em;
  }
  .home-hero-media {
    border-radius: 4px;
    overflow: hidden;
    background: color-mix(in srgb, var(--terracotta) 12%, var(--canvas));
  }
  img {
    display: block;
    width: 100%;
    height: clamp(300px, 34vw, 440px);
    object-fit: cover;
  }
  @media (max-width: 900px) {
    .home-hero {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
    img {
      height: clamp(240px, 56vw, 360px);
    }
  }
</style>
