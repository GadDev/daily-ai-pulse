---
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Search — The Daily AI Pulse"
  description="Search Pulse stories and daily editions."
>
  <section class="search-page">
    <p class="eyebrow">SEARCH THE PUBLICATION</p>
    <h1>Find the signal.</h1>
    <p class="search-dek">
      Search stories and editions by topic, tool, company, or engineering problem.
    </p>

    <form id="search-form" class="search-form" role="search">
      <label for="search-input">Search the publication</label>
      <input
        id="search-input"
        name="q"
        type="search"
        autocomplete="off"
        placeholder="Try “agent security”"
      />
      <button type="submit">Search →</button>
    </form>

    <p id="search-status" class="search-status" aria-live="polite"></p>
    <div id="search-results" class="search-results"></div>
    <p class="search-hint">
      Explore desks: <a href={`${base}research/`}>Research</a> ·
      <a href={`${base}tools/`}>Dev Tools</a> ·<a href={`${base}engineering/`}>AI Engineering</a>
    </p>
  </section>

  <script define:vars={{ base }}>
    const form = document.querySelector('#search-form');
    const input = document.querySelector('#search-input');
    const status = document.querySelector('#search-status');
    const resultsRoot = document.querySelector('#search-results');

    const params = new URLSearchParams(window.location.search);
    const initialQuery = params.get('q') ?? '';
    input.value = initialQuery;

    async function runSearch(query) {
      const trimmed = query.trim();
      resultsRoot.replaceChildren();

      if (!trimmed) {
        status.textContent = 'Enter a term to search the publication.';
        return;
      }

      status.textContent = 'Searching…';

      try {
        const pagefind = await import(`${base}pagefind/pagefind.js`);
        await pagefind.init();
        const search = await pagefind.search(trimmed);
        const items = await Promise.all(search.results.slice(0, 30).map((result) => result.data()));

        status.textContent = `${search.results.length} result${search.results.length === 1 ? '' : 's'} for “${trimmed}”.`;
        if (search.results.length === 0) {
          const empty = document.createElement('p');
          empty.className = 'search-empty';
          empty.textContent = 'No matches yet. Try a broader topic or browse a desk below.';
          resultsRoot.append(empty);
        }

        for (const item of items) {
          const article = document.createElement('article');
          article.className = 'search-result';

          const meta = document.createElement('p');
          meta.className = 'eyebrow';
          meta.textContent = item.url.includes('/stories/') ? 'STORY' : 'PULSE';

          const title = document.createElement('h2');
          const link = document.createElement('a');
          link.href = item.url;
          link.textContent = item.meta?.title ?? item.url;
          title.append(link);

          const excerpt = document.createElement('p');
          excerpt.className = 'search-excerpt';
          excerpt.textContent = (item.excerpt ?? '').replace(/<[^>]+>/g, '');

          article.append(meta, title, excerpt);
          resultsRoot.append(article);
        }
      } catch (error) {
        console.error(error);
        status.textContent =
          'Search is unavailable in development until the Pagefind index has been built.';
      }
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const query = input.value.trim();
      const url = new URL(window.location.href);
      if (query) url.searchParams.set('q', query);
      else url.searchParams.delete('q');
      history.replaceState({}, '', url);
      runSearch(query);
    });

    if (initialQuery) runSearch(initialQuery);
    else status.textContent = 'Enter a term to search the publication.';
  </script>
</BaseLayout>

<style>
  .search-page {
    max-width: 860px;
    margin: 0 auto;
    padding: 4rem 0 2rem;
  }
  h1 {
    margin: 0.35rem 0 1rem;
    max-width: 10ch;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(3.2rem, 6vw, 5.5rem);
    line-height: 0.98;
    letter-spacing: -0.05em;
  }
  .search-dek {
    max-width: 42rem;
    margin: 0 0 2rem;
    color: var(--muted);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.25rem;
    line-height: 1.45;
  }
  .search-form {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.75rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--ink);
  }
  .search-form label {
    grid-column: 1/-1;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .search-hint {
    margin-top: 2rem;
    color: var(--muted);
    font-size: 0.87rem;
  }
  .search-hint a {
    color: var(--accent);
    text-underline-offset: 0.2em;
  }
  :global(.search-empty) {
    padding: 2rem 0;
    color: var(--muted);
  }
  .search-form input {
    width: 100%;
    min-width: 0;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
  }
  .search-form button {
    padding: 0.9rem 1.2rem;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--canvas);
    cursor: pointer;
  }
  .search-status {
    min-height: 1.5rem;
    margin: 1.3rem 0;
    color: var(--muted);
    font:
      600 0.72rem/1.4 ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .search-results {
    border-top: 1px solid var(--line);
  }
  :global(.search-result) {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--line);
  }
  :global(.search-result h2) {
    margin: 0.35rem 0 0.65rem;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1.5rem, 4vw, 2.15rem);
    line-height: 1.05;
  }
  :global(.search-result h2 a) {
    text-decoration: none;
  }
  :global(.search-result h2 a:hover) {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  :global(.search-excerpt) {
    max-width: 48rem;
    margin: 0;
    color: var(--muted);
    line-height: 1.55;
  }
  @media (max-width: 560px) {
    .search-page {
      padding-top: 3rem;
    }
    .search-form {
      grid-template-columns: 1fr;
    }
  }
</style>
