---
import InformationLayout from '../../layouts/InformationLayout.astro';

const base = import.meta.env.BASE_URL;
---

<InformationLayout
  title="About — The Daily AI Pulse"
  description="An independent AI engineering publication by Alexandre Gadaix."
  eyebrow="ABOUT THE PUBLICATION"
  heading="Less noise. Better questions."
  dek="The Daily AI Pulse is an independent publication for software engineers who want to understand what changed in AI, how strong the evidence is, and what to do with it."
  current="about"
>
  <section class="row">
    <h2>Purpose</h2>
    <div>
      <p>
        Daily editions curate standalone stories across research, model releases, engineering,
        developer tools, practical workflows, real deployments, and the occasional genuinely curious
        result. A quiet day can mean a shorter edition.
      </p>
      <p>
        Each story aims to distinguish a technical result from a launch claim, a primary source from
        independent verification, and the facts from the editor’s take.
      </p>
    </div>
  </section>
  <section class="row">
    <h2>The editor</h2>
    <div>
      <p>
        Pulse is independently maintained by Alexandre Gadaix. Its editorial source and publication
        code are available in the{' '}
        <a href="https://github.com/GadDev/daily-ai-pulse">project repository</a>.
      </p>
      <p>
        Research and drafting may use AI tools. Published claims still need source review and
        editorial judgment; an AI summary is not treated as evidence on its own.
      </p>
    </div>
  </section>
  <section class="row">
    <h2>Explore</h2>
    <div>
      <p>
        Read the <a href={`${base}methodology/`}>editorial methodology</a> for selection, evidence
        labels, and corrections. <a href={`${base}categories/`}>Explore the desks</a> or{' '}
        <a href={`${base}subscribe/`}>follow new editions</a>.
      </p>
    </div>
  </section>
</InformationLayout>

<style>
  .row {
    display: grid;
    grid-template-columns: minmax(0, 35fr) minmax(0, 65fr);
    gap: 2rem;
  }
  .row h2 {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.78rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--terracotta);
    margin: 0.5rem 0 0;
  }
  .row p {
    font:
      1.15rem/1.7 Georgia,
      'Times New Roman',
      serif;
    margin: 0 0 1rem;
  }
  .row p:last-child {
    margin-bottom: 0;
  }
  @media (max-width: 860px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.5rem;
    }
  }
</style>
