---
interface Props {
  label: string;
  title: string;
  description?: string;
  href: string;
  image?: string;
  imageAlt?: string;
  meta?: string;
}

const { label, title, description, href, image, imageAlt, meta } = Astro.props;
---

<article class="story-card">
  <p class="label">{label}</p>
  {image && (
    <a class="story-image" href={href} aria-label={`Read ${title}`}>
      <img src={image} alt={imageAlt ?? ''} loading="lazy" />
    </a>
  )}
  <h3>
    <a href={href}>{title}</a>
  </h3>
  {description && <p class="description">{description}</p>}
  {meta && <p class="meta">{meta}</p>}
</article>

<style>
  .story-card {
    min-width: 0;
    padding: 0 0 1.4rem;
  }
  .label {
    margin: 0 0 0.85rem;
    font-weight: 700;
    color: var(--ink);
  }
  .story-image {
    display: block;
    aspect-ratio: 1.95/1;
    overflow: hidden;
    background: var(--surface-alt);
  }
  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.25s ease;
  }
  .story-image:hover img {
    transform: scale(1.02);
  }
  h3 {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1.45rem, 2vw, 2rem);
    line-height: 1.07;
    letter-spacing: -0.025em;
    margin: 0.8rem 0 0.45rem;
  }
  h3 a {
    text-decoration: none;
  }
  .description {
    line-height: 1.5;
    color: var(--muted);
    margin: 0 0 0.8rem;
  }
  .meta {
    margin: 0;
    color: var(--ink-muted);
    font:
      500 0.72rem/1.4 ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;
    text-transform: none;
    letter-spacing: 0;
  }
</style>
