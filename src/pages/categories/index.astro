---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categories } from '../../lib/categories';

const base = import.meta.env.BASE_URL;
const desks = Object.values(categories);
---

<BaseLayout
  title="Categories — The Daily AI Pulse"
  description="Explore the eight editorial desks of The Daily AI Pulse."
>
  <header class="issue-head categories-head">
    <p class="categories-eyebrow">EXPLORE THE PUBLICATION</p>
    <h1>Eight desks. One filter: signal.</h1>
    <p class="categories-dek">
      Different angles on the same fast-moving world. Choose a desk to explore our latest coverage,
      and get a sharper read on what actually matters in AI.
    </p>
  </header>
  <div class="desk-index">
    {desks.map((desk, index) => (
      <article class="desk">
        <span class="desk-number">{String(index + 1).padStart(2, '0')}</span>
        <h2>
          <a href={`${base}${desk.key}/`}>
            <span>{desk.title}</span>
            <span class="desk-arrow" aria-hidden="true">
              →
            </span>
          </a>
        </h2>
        <p>{desk.description}</p>
      </article>
    ))}
  </div>
</BaseLayout>

<style>
  .categories-head {
    padding: 4rem 0 2.5rem;
    border-bottom: 0;
  }
  .categories-eyebrow {
    margin: 0;
    color: var(--terracotta);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.2em;
  }
  .categories-head h1 {
    margin: 1.25rem 0 1rem;
    font-size: clamp(2.25rem, 6.2vw, 4.25rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.04em;
  }
  .categories-dek {
    max-width: 46rem;
    margin: 0;
    color: var(--muted);
    font-size: 1.15rem;
    line-height: 1.5;
  }
  .desk-index {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(2rem, 6vw, 4.5rem);
    margin: 0 0 4rem;
  }
  .desk {
    position: relative;
    padding: 1.4rem 0 1.75rem;
    border-top: 1px solid var(--line);
  }
  .desk-number {
    display: block;
    color: var(--terracotta);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
  }
  .desk h2 {
    margin: 0.35rem 0 0.3rem;
    font:
      500 clamp(1.9rem, 3.2vw, 2.4rem)/1.1 Georgia,
      'Times New Roman',
      serif;
    letter-spacing: -0.02em;
  }
  .desk a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 44px;
    text-decoration: none;
  }
  /* Stretched link: the whole row is the click and focus target. */
  .desk a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .desk a:focus-visible {
    outline: none;
  }
  .desk a:focus-visible::after {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .desk-arrow {
    flex: none;
    color: var(--terracotta);
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-weight: 400;
    transition: transform 0.15s ease;
  }
  .desk a:hover .desk-arrow {
    transform: translateX(0.25rem);
  }
  .desk p {
    margin: 0;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.5;
  }
  :global(body:has(.categories-head) .site-nav a.active) {
    color: var(--terracotta);
    border-bottom-color: var(--terracotta);
  }
  @media (max-width: 640px) {
    .categories-head {
      padding: 3rem 0 1.5rem;
    }
    .desk-index {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .desk-arrow {
      transition: none;
    }
  }
</style>
