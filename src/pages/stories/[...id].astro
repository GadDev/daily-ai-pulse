---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleToc from '../../components/ArticleToc.astro';

export async function getStaticPaths() {
  const stories = (await getCollection('stories')).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );

  return stories.map((story, index) => {
    const related = stories
      .filter((candidate) => candidate.id !== story.id)
      .map((candidate) => ({
        candidate,
        score:
          (candidate.data.category === story.data.category ? 2 : 0) +
          candidate.data.tags.filter((tag) => story.data.tags.includes(tag)).length,
      }))
      .filter(({ score }) => score > 0)
      .sort((a, b) => b.score - a.score || b.candidate.data.date.valueOf() - a.candidate.data.date.valueOf())
      .slice(0, 3)
      .map(({ candidate }) => candidate);

    return {
      params: { id: story.id },
      props: {
        story,
        newerStory: index > 0 ? stories[index - 1] : undefined,
        olderStory: index < stories.length - 1 ? stories[index + 1] : undefined,
        related,
      },
    };
  });
}

interface Props {
  story: CollectionEntry<'stories'>;
  newerStory?: CollectionEntry<'stories'>;
  olderStory?: CollectionEntry<'stories'>;
  related: CollectionEntry<'stories'>[];
}

const { story, newerStory, olderStory, related } = Astro.props;
const { Content, headings } = await render(story);
const base = import.meta.env.BASE_URL;
const tocItems = headings
  .filter((heading) => heading.depth === 2 || heading.depth === 3)
  .map((heading) => ({ id: heading.slug, label: heading.text }));
const publishedDate = story.data.date.toLocaleDateString('en-GB', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});
const imageSrc = story.data.image
  ? story.data.image.startsWith('/')
    ? `${base}${story.data.image.slice(1)}`
    : story.data.image
  : undefined;
---

<BaseLayout title={`${story.data.title} — Pulse`} description={story.data.description}>
  <article class="article-shell">
    <header class="article-header">
      <p class="eyebrow">{story.data.category} / {story.data.type}</p>
      <h1>{story.data.title}</h1>
      <p class="dek">{story.data.description}</p>

      <div class="article-meta" aria-label="Article metadata">
        <time datetime={story.data.date.toISOString()}>{publishedDate}</time>
        <span class={`evidence-badge evidence-${story.data.evidence}`}>evidence / {story.data.evidence}</span>
        <span>signal / {story.data.signal}</span>
        <span>{story.data.difficulty}</span>
      </div>
    </header>

    {imageSrc && (
      <figure class="article-hero">
        <img src={imageSrc} alt={story.data.imageAlt ?? ''} loading="eager" />
      </figure>
    )}

    <div class="article-layout">
      <div class="article-main">
        <div class="prose"><Content /></div>

        {story.data.sources.length > 0 && (
          <section class="sources" aria-labelledby="sources-title">
            <p class="eyebrow">VERIFICATION</p>
            <h2 id="sources-title">Sources</h2>
            <ol>
              {story.data.sources.map((source) => (
                <li><a href={source.url} target="_blank" rel="noreferrer">{source.label}</a></li>
              ))}
            </ol>
          </section>
        )}
      </div>

      {tocItems.length > 0 && (
        <aside class="article-aside">
          <ArticleToc items={tocItems} />
        </aside>
      )}
    </div>

    {related.length > 0 && (
      <section class="related" aria-labelledby="related-title">
        <p class="eyebrow">KEEP READING</p>
        <h2 id="related-title">Related stories</h2>
        <div class="related-grid">
          {related.map((item) => (
            <article>
              <p class="label">{item.data.category} / {item.data.type}</p>
              <h3><a href={`${base}stories/${item.id}/`}>{item.data.title}</a></h3>
              <p>{item.data.description}</p>
            </article>
          ))}
        </div>
      </section>
    )}

    {(olderStory || newerStory) && (
      <nav class="article-pager" aria-label="Article navigation">
        <div>
          {olderStory && (
            <a href={`${base}stories/${olderStory.id}/`}>
              <span>← Older</span>
              <strong>{olderStory.data.title}</strong>
            </a>
          )}
        </div>
        <div class="next">
          {newerStory && (
            <a href={`${base}stories/${newerStory.id}/`}>
              <span>Newer →</span>
              <strong>{newerStory.data.title}</strong>
            </a>
          )}
        </div>
      </nav>
    )}
  </article>
</BaseLayout>

<style>
  .article-shell{max-width:1100px;margin:0 auto}
  .article-header{padding:4rem 0 2.2rem;border-bottom:1px solid var(--line)}
  .article-header h1{font-family:Georgia,'Times New Roman',serif;font-size:clamp(3.2rem,8vw,7rem);line-height:.9;letter-spacing:-.05em;max-width:13ch;margin:.65rem 0 1.1rem}
  .article-header .dek{font-family:Georgia,'Times New Roman',serif;font-size:clamp(1.25rem,2.2vw,1.7rem);line-height:1.35;max-width:44rem;margin:0;color:var(--muted)}
  .article-meta{display:flex;flex-wrap:wrap;gap:.55rem 1.2rem;align-items:center;margin-top:1.5rem;padding-top:1rem;border-top:1px solid var(--line);font:600 .7rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.05em;text-transform:uppercase;color:var(--muted)}
  .evidence-badge{border:1px solid var(--line);border-radius:999px;padding:.35rem .55rem;color:var(--ink)}
  .article-hero{margin:2rem 0 0;border-radius:8px;overflow:hidden;background:var(--surface-alt)}
  .article-hero img{display:block;width:100%;aspect-ratio:16/8.6;object-fit:cover}
  .article-layout{display:grid;grid-template-columns:minmax(0,46rem) minmax(12rem,16rem);gap:clamp(3rem,8vw,8rem);align-items:start;padding:3rem 0 1rem}
  .article-aside{position:sticky;top:7rem}
  .prose{font-family:Georgia,'Times New Roman',serif;font-size:1.13rem;line-height:1.78}
  :global(.prose h2){font-size:2rem;line-height:1.05;margin:3.3rem 0 1rem;letter-spacing:-.025em}
  :global(.prose h3){font-size:1.4rem;line-height:1.15;margin:2.2rem 0 .8rem}
  :global(.prose p){margin:0 0 1.35rem}
  :global(.prose a){text-underline-offset:.18em}
  :global(.prose blockquote){margin:2.5rem 0;padding:1.4rem 1.5rem 1.5rem;border-top:1px solid var(--ink);border-bottom:1px solid var(--line);font-size:1.2rem;line-height:1.55;background:rgba(255,255,255,.16)}
  :global(.prose blockquote::before){content:'PULSE TAKE';display:block;margin-bottom:.7rem;font:700 .68rem/1 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.09em;color:var(--muted)}
  :global(.prose pre){overflow:auto;padding:1.2rem;border:1px solid var(--line);background:var(--surface);font-size:.88rem}
  .sources{margin-top:4rem;padding:1.5rem 0;border-top:1px solid var(--ink)}
  .sources h2,.related h2{font-family:Georgia,'Times New Roman',serif;font-size:2rem;margin:.45rem 0 1.2rem}
  .sources ol{margin:0;padding-left:1.25rem;display:grid;gap:.75rem}
  .sources a{text-underline-offset:.2em}
  .related{margin-top:4.5rem;padding-top:1.5rem;border-top:1px solid var(--ink)}
  .related-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:1px solid var(--line)}
  .related-grid article{padding:1.2rem 1.4rem 1.4rem 0;border-bottom:1px solid var(--line)}
  .related-grid article+article{padding-left:1.4rem;border-left:1px solid var(--line)}
  .related-grid h3{font-family:Georgia,'Times New Roman',serif;font-size:1.35rem;line-height:1.08;margin:.4rem 0 .65rem}
  .related-grid h3 a{text-decoration:none}
  .related-grid article>p:not(.label){margin:0;color:var(--muted);line-height:1.5;font-size:.92rem}
  .article-pager{display:grid;grid-template-columns:1fr 1fr;gap:2rem;margin:4rem 0 1rem;padding:1.5rem 0;border-top:1px solid var(--ink);border-bottom:1px solid var(--line)}
  .article-pager a{display:grid;gap:.45rem;text-decoration:none}
  .article-pager span{font:600 .68rem/1 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
  .article-pager strong{font-family:Georgia,'Times New Roman',serif;font-size:1.15rem;line-height:1.18;font-weight:600}
  .article-pager .next{text-align:right}
  @media(max-width:860px){
    .article-layout{grid-template-columns:1fr;gap:1.5rem}
    .article-aside{position:static;order:-1}
    .related-grid{grid-template-columns:1fr}
    .related-grid article+article{padding-left:0;border-left:0}
  }
  @media(max-width:620px){
    .article-header{padding-top:3rem}
    .article-pager{grid-template-columns:1fr}
    .article-pager .next{text-align:left}
  }
</style>
