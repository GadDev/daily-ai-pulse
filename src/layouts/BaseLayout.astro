---
import '../styles/global.css';
import SearchButton from '../components/SearchButton.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  section?: string;
  tags?: string[];
}

const {
  title = 'The Daily AI Pulse',
  description = 'Signal over noise in AI.',
  image,
  type = 'website',
  publishedTime,
  section,
  tags = [],
} = Astro.props;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
const isActive = (path: string) => currentPath === path || currentPath.startsWith(`${path}/`);
const site = Astro.site ?? new URL('https://gaddev.github.io');
const canonicalUrl = new URL(currentPath, site).toString();
const rssUrl = new URL(`${base}rss.xml`, site).toString();
const absoluteImage = image
  ? new URL(image.startsWith('/') ? `${base}${image.slice(1)}` : image, site).toString()
  : undefined;
const socialImage = absoluteImage ?? new URL(`${base}images/editorial/hero.svg`, site).toString();
const structuredData =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: title,
        description,
        mainEntityOfPage: canonicalUrl,
        datePublished: publishedTime,
        articleSection: section,
        keywords: tags.join(', '),
        image: socialImage,
        publisher: {
          '@type': 'Organization',
          name: 'The Daily AI Pulse',
          url: new URL(base, site).toString(),
        },
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: 'The Daily AI Pulse',
        url: new URL(base, site).toString(),
        description: 'Signal over noise in AI.',
      };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3ebdd" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="The Daily AI Pulse RSS" href={rssUrl} />

    <meta property="og:site_name" content="The Daily AI Pulse" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {type === 'article' && section && <meta property="article:section" content={section} />}
    {type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href={base} aria-label="The Daily AI Pulse home">
          The Daily AI Pulse
        </a>

        <nav class="site-nav" aria-label="Primary navigation">
          <a class:list={{ active: currentPath === base }} href={base}>
            Home
          </a>
          <a class:list={{ active: isActive(`${base}pulse`) }} href={`${base}pulse/`}>
            Pulse
          </a>
          <a href={`${base}#categories`}>Categories</a>
          <a href="#about">About</a>
        </nav>

        <div class="site-actions">
          <SearchButton />
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer" id="about">
      <div class="site-footer__topline">
        <span>THE DAILY AI PULSE</span>
        <span>SIGNAL OVER NOISE IN AI</span>
      </div>

      <div class="site-footer__grid">
        <section class="footer-publication">
          <a class="brand brand--footer" href={base}>
            The Daily AI Pulse
          </a>
          <p class="footer-copy footer-copy--lead">Clear. Curated. Consequential.</p>
          <p class="footer-copy">
            A daily publication for engineers following the AI developments that actually change how
            software is built.
          </p>
          <div class="footer-links-inline" aria-label="Publication links">
            <a href="https://github.com/GadDev/daily-ai-pulse" target="_blank" rel="noreferrer">
              GitHub ↗
            </a>
            <a href={`${base}rss.xml`}>RSS</a>
          </div>
        </section>

        <section>
          <h2>Explore</h2>
          <a href={base}>Home</a>
          <a href={`${base}pulse/`}>Pulse Archive</a>
          <a href={`${base}search/`}>Search</a>
          <a href={`${base}research/`}>Research</a>
          <a href={`${base}tools/`}>Dev Tools</a>
        </section>

        <section>
          <h2>Categories</h2>
          <a href={`${base}models/`}>Models & Releases</a>
          <a href={`${base}engineering/`}>AI Engineering</a>
          <a href={`${base}practice/`}>AI in Practice</a>
          <a href={`${base}workflows/`}>Workflows</a>
          <a href={`${base}business/`}>Business & Industry</a>
          <a href={`${base}curious/`}>Curious AI</a>
        </section>

        <section>
          <h2>About</h2>
          <p class="footer-copy">
            Evidence-first AI engineering coverage with primary sources, explicit confidence, and a
            clearly separated editorial point of view.
          </p>
          <a
            href="https://github.com/GadDev/daily-ai-pulse/blob/main/docs/EDITORIAL.md"
            target="_blank"
            rel="noreferrer"
          >
            Editorial standard ↗
          </a>
          <a href={`${base}rss.xml`}>Follow via RSS</a>
        </section>
      </div>

      <div class="site-footer__bottom">
        <span>© 2026 The Daily AI Pulse</span>
        <span>Independent AI engineering publication</span>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: static;
    background: transparent;
    border-bottom: 0;
    backdrop-filter: none;
  }
  .site-header__inner {
    min-height: 78px;
  }
  .site-nav {
    gap: 1.7rem;
    font-size: 0.8rem;
  }
  .brand {
    font-size: 1.45rem;
  }
</style>
