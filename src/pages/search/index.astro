---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categories } from '../../lib/categories';

const base = import.meta.env.BASE_URL;
const categoryList = Object.values(categories).map(({ key, title }) => ({ key, title }));
const exploreDefaults = categoryList.slice(0, 3);
---

<BaseLayout
  title="Search — The Daily AI Pulse"
  description="Search Pulse stories and daily editions."
>
  <section class="search-page">
    <header class="search-head">
      <p class="eyebrow">Search the publication</p>
      <h1>Find the signal.</h1>
      <p class="search-dek">Search stories and daily editions by topic, tool, or company.</p>
    </header>

    <div class="search-controls">
      <form id="search-form" class="search-form" role="search">
        <label for="search-input">Search</label>
        <div class="search-row">
          <div class="search-field">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="11" cy="11" r="6.5"></circle>
              <path d="m16 16 4 4"></path>
            </svg>
            <input id="search-input" name="q" type="search" autocomplete="off" />
          </div>
          <button type="submit">Search</button>
        </div>
      </form>
    </div>

    <p id="search-status" class="search-status" aria-live="polite"></p>
    <div id="search-results" class="search-results"></div>

    <nav id="search-explore" class="search-explore" aria-label="Explore more categories">
      <span class="explore-label">Explore more</span>
      <ul>
        {exploreDefaults.map(({ key, title }) => (
          <li>
            <a href={`${base}${key}/`}>
              {title} <span aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </section>

  <script define:vars={{ base, categoryList }}>
    const form = document.querySelector('#search-form');
    const input = document.querySelector('#search-input');
    const status = document.querySelector('#search-status');
    const resultsRoot = document.querySelector('#search-results');
    const exploreList = document.querySelector('#search-explore ul');

    const categoryTitles = new Map(categoryList.map(({ key, title }) => [key, title]));

    const params = new URLSearchParams(window.location.search);
    const initialQuery = params.get('q') ?? '';
    input.value = initialQuery;

    function el(tag, className, text) {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (text !== undefined) node.textContent = text;
      return node;
    }

    function renderExplore(resultKeys) {
      const keys = [...new Set(resultKeys.filter((key) => categoryTitles.has(key)))];
      for (const { key } of categoryList) {
        if (keys.length >= 3) break;
        if (!keys.includes(key)) keys.push(key);
      }

      exploreList.replaceChildren(
        ...keys.slice(0, 3).map((key) => {
          const item = document.createElement('li');
          const link = el('a', '', `${categoryTitles.get(key)} `);
          link.href = `${base}${key}/`;
          const arrow = el('span', '', '→');
          arrow.setAttribute('aria-hidden', 'true');
          link.append(arrow);
          item.append(link);
          return item;
        }),
      );
    }

    function formatDate(iso) {
      const date = new Date(iso);
      if (Number.isNaN(date.valueOf())) return null;
      const time = el('time', 'result-date');
      time.dateTime = date.toISOString().slice(0, 10);
      time.textContent = date.toLocaleDateString('en-US', {
        month: 'short',
        day: 'numeric',
        year: 'numeric',
        timeZone: 'UTC',
      });
      return time;
    }

    function renderResult(item) {
      const meta = item.meta ?? {};
      const isEdition = meta.kind === 'edition';
      const deskTitle = categoryTitles.get(meta.categoryKey) ?? meta.category;

      const article = el('article', 'search-result');
      const main = el('div', 'result-main');
      main.append(el('p', 'result-desk', isEdition ? 'Pulse' : (deskTitle ?? 'Story')));

      const title = el('h2');
      const link = el('a', '', (meta.title ?? item.url).replace(/\s*[—|]\s*Pulse$/, ''));
      link.href = item.url;
      title.append(link);

      main.append(title, el('p', 'search-excerpt', (item.excerpt ?? '').replace(/<[^>]+>/g, '')));
      article.append(main);

      const aside = el('div', 'result-meta');
      if (isEdition) {
        aside.append(el('p', 'result-meta-label', 'Edition'));
      } else if (meta.evidence) {
        aside.append(
          el('p', 'result-meta-label', 'Evidence'),
          el(
            'p',
            'result-evidence',
            meta.evidence.charAt(0).toUpperCase() + meta.evidence.slice(1),
          ),
        );
      }
      const time = meta.date ? formatDate(meta.date) : null;
      if (time) aside.append(time);
      if (aside.childElementCount > 0) article.append(aside);

      return article;
    }

    async function runSearch(query) {
      const trimmed = query.trim();
      resultsRoot.replaceChildren();
      renderExplore([]);

      if (!trimmed) {
        status.textContent = 'Enter a term to search the publication.';
        return;
      }

      status.textContent = 'Searching…';

      try {
        const pagefind = await import(`${base}pagefind/pagefind.js`);
        await pagefind.init();
        const search = await pagefind.search(trimmed);
        const items = await Promise.all(search.results.slice(0, 30).map((result) => result.data()));
        const count = search.results.length;

        status.replaceChildren(
          document.createTextNode(`${count} result${count === 1 ? '' : 's'}`),
          el('span', 'sr-only', ` for “${trimmed}”`),
        );

        resultsRoot.append(...items.map(renderResult));
        renderExplore(items.map((item) => item.meta?.categoryKey));
      } catch (error) {
        console.error(error);
        status.textContent =
          'Search is unavailable in development until the Pagefind index has been built.';
      }
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const query = input.value.trim();
      const url = new URL(window.location.href);
      if (query) url.searchParams.set('q', query);
      else url.searchParams.delete('q');
      history.replaceState({}, '', url);
      runSearch(query);
    });

    if (initialQuery) runSearch(initialQuery);
    else status.textContent = 'Enter a term to search the publication.';
  </script>
</BaseLayout>

<style>
  .search-page {
    padding: 2.4rem 0 3rem;
  }
  .search-head {
    padding-bottom: 2rem;
  }
  .eyebrow {
    margin: 0;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--terracotta);
  }
  h1 {
    margin: 0.5rem 0 0.6rem;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(3rem, 8vw, 5.5rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.045em;
  }
  .search-dek {
    max-width: 36rem;
    margin: 0;
    color: var(--muted);
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    line-height: 1.35;
  }
  .search-controls {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--line);
  }
  .search-form {
    width: min(100%, 80%);
  }
  .search-form label {
    display: block;
    margin-bottom: 0.5rem;
    font-size: 0.9rem;
    font-weight: 500;
  }
  .search-row {
    display: grid;
    grid-template-columns: 1fr minmax(8rem, 12rem);
    gap: 0.75rem;
  }
  .search-field {
    position: relative;
  }
  .search-field svg {
    position: absolute;
    left: 1rem;
    top: 50%;
    width: 1.2rem;
    height: 1.2rem;
    transform: translateY(-50%);
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.4;
    pointer-events: none;
  }
  .search-field input {
    width: 100%;
    min-width: 0;
    min-height: 3.5rem;
    padding: 0 1rem 0 3rem;
    border: 1px solid var(--muted);
    border-radius: 4px;
    background: var(--surface);
    color: var(--ink);
  }
  .search-row button {
    min-height: 3.5rem;
    padding: 0 1.2rem;
    border: 1px solid var(--ink);
    border-radius: 4px;
    background: var(--ink);
    color: var(--canvas);
    font-weight: 500;
    cursor: pointer;
  }
  .search-status {
    min-height: 1.5rem;
    margin: 1.4rem 0 0.8rem;
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .search-explore {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 2.5rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
  }
  .explore-label {
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .search-explore ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .search-explore :global(a) {
    display: inline-block;
    padding: 0.6rem 0;
    color: var(--terracotta);
    font-family: Georgia, 'Times New Roman', serif;
    text-decoration: none;
  }
  .search-explore :global(a:hover) {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  :global(.search-result) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(10rem, 20%);
    align-items: center;
    gap: 2rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--line);
  }
  :global(.search-result:first-child) {
    border-top: 0;
  }
  :global(.search-result .result-desk) {
    margin: 0;
    color: var(--terracotta);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  :global(.search-result h2) {
    margin: 0.25rem 0 0.5rem;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 400;
    line-height: 1.1;
  }
  :global(.search-result h2 a) {
    text-decoration: none;
  }
  :global(.search-result h2 a:hover) {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  :global(.search-result h2 a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  :global(.search-excerpt) {
    max-width: 60ch;
    margin: 0;
    color: var(--muted);
    line-height: 1.5;
  }
  :global(.search-result .result-meta) {
    padding-left: 2rem;
    border-left: 1px solid var(--line);
  }
  :global(.search-result .result-meta p) {
    margin: 0;
  }
  :global(.search-result .result-meta-label) {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  :global(.search-result .result-evidence) {
    margin-top: 0.2rem;
    font-size: 0.92rem;
  }
  :global(.search-result .result-date) {
    display: block;
    margin-top: 0.9rem;
    color: var(--muted);
    font:
      0.75rem/1.2 ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  @media (max-width: 820px) {
    .search-form {
      width: 100%;
    }
    :global(.search-result) {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    :global(.search-result .result-meta) {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.25rem 1rem;
      padding: 0.75rem 0 0;
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    :global(.search-result .result-date) {
      margin-top: 0;
    }
  }
  @media (max-width: 560px) {
    .search-row {
      grid-template-columns: 1fr;
    }
  }
</style>
