---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleToc from '../../components/ArticleToc.astro';
import PulseTake from '../../components/editorial/PulseTake.astro';
import Evidence from '../../components/editorial/Evidence.astro';
import TryThis from '../../components/editorial/TryThis.astro';
import EditorialQuote from '../../components/editorial/EditorialQuote.astro';
import { categoryLabel, evidenceLabel, readingTime } from '../../lib/editorial';

export async function getStaticPaths() {
  const stories = (await getCollection('stories'))
    .filter((story) => !story.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  return stories.map((story, index) => {
    const related = stories
      .filter((candidate) => candidate.id !== story.id)
      .map((candidate) => ({
        candidate,
        score:
          (candidate.data.category === story.data.category ? 2 : 0) +
          candidate.data.tags.filter((tag) => story.data.tags.includes(tag)).length,
      }))
      .filter(({ score }) => score > 0)
      .sort(
        (a, b) =>
          b.score - a.score || b.candidate.data.date.valueOf() - a.candidate.data.date.valueOf(),
      )
      .slice(0, 3)
      .map(({ candidate }) => candidate);

    return {
      params: { id: story.id },
      props: {
        story,
        newerStory: index > 0 ? stories[index - 1] : undefined,
        olderStory: index < stories.length - 1 ? stories[index + 1] : undefined,
        related,
      },
    };
  });
}

interface Props {
  story: CollectionEntry<'stories'>;
  newerStory?: CollectionEntry<'stories'>;
  olderStory?: CollectionEntry<'stories'>;
  related: CollectionEntry<'stories'>[];
}

const { story, newerStory, olderStory, related } = Astro.props;
const { Content, headings } = await render(story);
const base = import.meta.env.BASE_URL;
const tocItems = headings
  .filter((heading) => heading.depth === 2 || heading.depth === 3)
  .map((heading) => ({ id: heading.slug, label: heading.text }));
const publishedDate = story.data.date.toLocaleDateString('en-GB', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});
const imageSrc = story.data.image.startsWith('/')
  ? `${base}${story.data.image.slice(1)}`
  : story.data.image;
---

<BaseLayout
  title={`${story.data.title} — Pulse`}
  description={story.data.description}
  image={story.data.image}
  type="article"
  publishedTime={story.data.date.toISOString()}
  section={story.data.category}
  tags={story.data.tags}
>
  <article class="article-shell">
    <a class="back-link" href={`${base}pulse/`}>
      ← Pulse archive
    </a>
    <header class="article-header">
      <p class="eyebrow">
        {categoryLabel(story)} / {story.data.type === 'deep-dive' ? 'Deep dive' : 'Analysis'}
      </p>
      <h1>{story.data.title}</h1>
      <p class="dek">{story.data.description}</p>

      <div class="article-meta" aria-label="Article metadata">
        <time datetime={story.data.date.toISOString()}>{publishedDate}</time>
        <span>The Daily AI Pulse</span>
        <span>{readingTime(story)}</span>
        <a href={`${base}methodology/`}>{evidenceLabel(story)} ↗</a>
        {story.data.signal === 'high' && <span class="high-signal">High signal</span>}
      </div>
    </header>

    <figure class="article-hero">
      <img src={imageSrc} alt={story.data.imageAlt} loading="eager" />
    </figure>

    <div class:list={['article-layout', { 'has-toc': tocItems.length > 0 }]}>
      {tocItems.length > 0 && (
        <aside class="article-aside">
          <ArticleToc items={tocItems} />
        </aside>
      )}
      <div class="article-main">
        <div class="prose">
          <Content components={{ PulseTake, Evidence, TryThis, EditorialQuote }} />
        </div>

        {story.data.sources.length > 0 && (
          <section class="sources" aria-labelledby="sources-title">
            <p class="eyebrow">VERIFICATION</p>
            <h2 id="sources-title">Sources</h2>
            <ol>
              {story.data.sources.map((source) => (
                <li>
                  <a href={source.url} target="_blank" rel="noreferrer">
                    {source.label}
                  </a>
                </li>
              ))}
            </ol>
          </section>
        )}
      </div>
    </div>

    {related.length > 0 && (
      <section class="related" aria-labelledby="related-title">
        <p class="eyebrow">KEEP READING</p>
        <h2 id="related-title">Related stories</h2>
        <div class="related-grid">
          {related.map((item) => (
            <article>
              <p class="label">
                {item.data.category} / {item.data.type}
              </p>
              <h3>
                <a href={`${base}stories/${item.id}/`}>{item.data.title}</a>
              </h3>
              <p>{item.data.description}</p>
            </article>
          ))}
        </div>
      </section>
    )}

    {(olderStory || newerStory) && (
      <nav class="article-pager" aria-label="Article navigation">
        <div>
          {olderStory && (
            <a href={`${base}stories/${olderStory.id}/`}>
              <span>← Older</span>
              <strong>{olderStory.data.title}</strong>
            </a>
          )}
        </div>
        <div class="next">
          {newerStory && (
            <a href={`${base}stories/${newerStory.id}/`}>
              <span>Newer →</span>
              <strong>{newerStory.data.title}</strong>
            </a>
          )}
        </div>
      </nav>
    )}
  </article>
</BaseLayout>

<style>
  .article-shell {
    max-width: 1100px;
    margin: 0 auto;
  }
  .back-link {
    display: inline-block;
    margin-top: 1.5rem;
    color: var(--muted);
    font-size: 0.85rem;
    text-decoration: none;
  }
  .article-header {
    padding: 2rem 0 1.8rem;
    border-bottom: 1px solid var(--line);
  }
  .article-header h1 {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(3rem, 6vw, 5.2rem);
    line-height: 0.98;
    letter-spacing: -0.05em;
    max-width: 23ch;
    margin: 0.65rem 0 1.1rem;
  }
  .article-header .dek {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1.25rem, 2.2vw, 1.7rem);
    line-height: 1.35;
    max-width: 44rem;
    margin: 0;
    color: var(--muted);
  }
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.2rem;
    align-items: center;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font:
      600 0.7rem/1.2 ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .article-meta a {
    text-underline-offset: 0.2em;
  }
  .high-signal {
    color: var(--accent);
  }
  .article-hero {
    margin: 1.5rem 0 0;
    overflow: hidden;
    background: var(--surface-alt);
  }
  .article-hero img {
    display: block;
    width: 100%;
    aspect-ratio: 16/8.6;
    object-fit: cover;
  }
  .article-layout {
    display: grid;
    grid-template-columns: minmax(0, 46rem);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
    padding: 3rem 0 1rem;
  }
  .article-layout.has-toc {
    grid-template-columns: minmax(10rem, 13rem) minmax(0, 46rem);
  }
  .article-aside {
    grid-column: 1;
    grid-row: 1;
    position: sticky;
    top: 2rem;
  }
  .article-main {
    grid-column: 1;
    grid-row: 1;
  }
  .has-toc .article-main {
    grid-column: 2;
  }
  .prose {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.13rem;
    line-height: 1.78;
  }
  :global(.prose h2) {
    font-size: 2rem;
    line-height: 1.05;
    margin: 3.3rem 0 1rem;
    letter-spacing: -0.025em;
  }
  :global(.prose h3) {
    font-size: 1.4rem;
    line-height: 1.15;
    margin: 2.2rem 0 0.8rem;
  }
  :global(.prose p) {
    margin: 0 0 1.35rem;
  }
  :global(.prose a) {
    text-underline-offset: 0.18em;
  }
  :global(.prose blockquote) {
    margin: 2.5rem 0;
    padding-left: 1.4rem;
    border-left: 3px solid var(--line);
    font-size: 1.15rem;
    line-height: 1.6;
    font-style: italic;
  }
  :global(.prose pre) {
    overflow: auto;
    padding: 1.2rem;
    border: 1px solid var(--line);
    background: var(--surface);
    font-size: 0.88rem;
  }
  .sources {
    margin-top: 4rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--ink);
  }
  .sources h2,
  .related h2 {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 2rem;
    margin: 0.45rem 0 1.2rem;
  }
  .sources ol {
    margin: 0;
    padding-left: 1.25rem;
    display: grid;
    gap: 0.75rem;
  }
  .sources a {
    text-underline-offset: 0.2em;
  }
  .related {
    margin-top: 4.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--ink);
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }
  .related-grid article {
    padding: 1.2rem 1.4rem 1.4rem 0;
    border-bottom: 1px solid var(--line);
  }
  .related-grid article + article {
    padding-left: 1.4rem;
    border-left: 1px solid var(--line);
  }
  .related-grid h3 {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.35rem;
    line-height: 1.08;
    margin: 0.4rem 0 0.65rem;
  }
  .related-grid h3 a {
    text-decoration: none;
  }
  .related-grid article > p:not(.label) {
    margin: 0;
    color: var(--muted);
    line-height: 1.5;
    font-size: 0.92rem;
  }
  .article-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin: 4rem 0 1rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--line);
  }
  .article-pager a {
    display: grid;
    gap: 0.45rem;
    text-decoration: none;
  }
  .article-pager span {
    font:
      600 0.68rem/1 ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .article-pager strong {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.15rem;
    line-height: 1.18;
    font-weight: 600;
  }
  .article-pager .next {
    text-align: right;
  }
  @media (max-width: 860px) {
    .article-layout,
    .article-layout.has-toc {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .article-aside {
      position: static;
      grid-column: 1;
      grid-row: 1;
    }
    .article-main,
    .has-toc .article-main {
      grid-column: 1;
      grid-row: 2;
    }
    .related-grid {
      grid-template-columns: 1fr;
    }
    .related-grid article + article {
      padding-left: 0;
      border-left: 0;
    }
  }
  @media (max-width: 620px) {
    .article-header {
      padding-top: 3rem;
    }
    .article-pager {
      grid-template-columns: 1fr;
    }
    .article-pager .next {
      text-align: left;
    }
  }
</style>
