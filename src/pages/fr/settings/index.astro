---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ThemeModeToggle from '../../../components/ThemeModeToggle.astro';
import { messages, type Locale } from '../../../lib/i18n';

const locale: Locale = 'fr';
const text = messages[locale];
---

<BaseLayout
  locale={locale}
  title={`${text.settings} | The Daily AI Pulse`}
  description="Gérez vos préférences pour The Daily AI Pulse."
  noindex={true}
>
  <main class="settings-page">
    <header class="settings-header">
      <h1>{text.settings}</h1>
    </header>

    <section class="settings-section" aria-labelledby="appearance-heading">
      <h2 id="appearance-heading" class="settings-section__title">
        {text.appearance}
      </h2>
      <ThemeModeToggle locale={locale} />
    </section>
  </main>
</BaseLayout>

<style>
  .settings-page {
    max-width: 48rem;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
  }

  .settings-header {
    margin-bottom: 3rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .settings-header h1 {
    font:
      700 clamp(2.2rem, 4.4vw, 3.5rem) / 1.1 Georgia,
      'Times New Roman',
      serif;
    letter-spacing: -0.03em;
    margin: 0;
    color: var(--ink);
  }

  .settings-section {
    margin-bottom: 3rem;
  }

  .settings-section__title {
    font:
      600 1.1rem/1.3 ui-sans-serif,
      system-ui,
      sans-serif;
    color: var(--ink);
    margin: 0 0 1rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  @media (max-width: 640px) {
    .settings-page {
      padding: 2rem 1rem 4rem;
    }
  }
</style>
