---
interface Props {
  title: string;
  description: string;
  href: string;
  image: string;
  imageAlt: string;
  desk: string;
  readingTime: string;
  size?: 'wide' | 'narrow';
}

const { title, description, href, image, imageAlt, desk, readingTime, size = 'wide' } = Astro.props;
---

<article class:list={['story-card', `story-card--${size}`]}>
  <img src={image} alt={imageAlt} loading="lazy" />
  <div class="story-card-body">
    <p class="desk">{desk}</p>
    <h3>
      <a href={href}>{title}</a>
    </h3>
    <p class="deck">{description}</p>
    <p class="read-time">{readingTime}</p>
  </div>
</article>

<style>
  .story-card {
    position: relative;
    display: grid;
    grid-template-columns: var(--media-col) minmax(0, 1fr);
    gap: clamp(1rem, 2vw, 1.875rem);
    align-items: start;
  }
  .story-card--wide {
    --media-col: 47%;
  }
  .story-card--narrow {
    --media-col: 36%;
  }
  img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    background: var(--surface-alt);
  }
  .story-card-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    align-self: stretch;
    min-width: 0;
  }
  .desk {
    margin: 0;
    color: var(--terracotta);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  h3 {
    margin: 0.5rem 0 0.55rem;
    font:
      400 clamp(1.15rem, 1.6vw, 1.45rem) / 1.2 Georgia,
      'Times New Roman',
      serif;
    letter-spacing: -0.015em;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  h3 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.14em;
  }
  h3 a:focus-visible {
    outline: none;
  }
  h3 a:focus-visible::after {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
  .deck {
    margin: 0;
    color: var(--muted);
    font: 0.95rem / 1.45 var(--font-deck);
  }
  .read-time {
    margin: auto 0 0;
    padding-top: 0.85rem;
    color: var(--muted);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  @media (max-width: 700px) {
    .story-card {
      grid-template-columns: 1fr;
    }
    img {
      aspect-ratio: 16 / 10;
    }
  }
</style>
