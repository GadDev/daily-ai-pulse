---
interface Item {
  id: string;
  label: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<nav class="article-toc" aria-label="In this article">
  <p class="toc-label">IN THIS ARTICLE</p>
  <ol>
    {items.map((item) => (
      <li>
        <a href={`#${item.id}`} data-toc-link>
          {item.label}
        </a>
      </li>
    ))}
  </ol>
</nav>

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
  const targets = links.map((link) =>
    document.getElementById(decodeURIComponent(link.hash.slice(1))),
  );

  const setCurrent = (index: number) => {
    links.forEach((link, i) => {
      if (i === index) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  };

  let frame = 0;
  const update = () => {
    frame = 0;
    const line = window.innerHeight * 0.35;
    let current = -1;
    targets.forEach((target, i) => {
      if (target && target.getBoundingClientRect().top <= line) current = i;
    });
    const first = targets[0];
    if (current < 0 && first && first.getBoundingClientRect().top < window.innerHeight) {
      current = 0;
    }
    const atBottom =
      window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
    if (atBottom && window.scrollY > 0 && targets[targets.length - 1]) {
      current = targets.length - 1;
    }
    setCurrent(current);
  };
  const schedule = () => {
    if (!frame) frame = requestAnimationFrame(update);
  };

  if (links.length > 0) {
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    update();
  }
</script>

<style>
  .article-toc {
    padding: 0.25rem 2rem 0.5rem 0;
    border-right: 1px solid var(--line);
  }
  .toc-label {
    margin: 0 0 0.75rem 1.1rem;
    font:
      700 0.68rem/1.2 Inter,
      ui-sans-serif,
      system-ui,
      sans-serif;
    letter-spacing: 0.14em;
    color: var(--ink);
  }
  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0.35rem 0 0.35rem 1rem;
    border-left: 3px solid transparent;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1rem;
    line-height: 1.3;
    text-decoration: none;
    color: var(--ink-muted);
  }
  a:hover {
    color: var(--ink);
  }
  a[aria-current='location'] {
    border-left-color: var(--terracotta);
    color: var(--terracotta);
    font-weight: 700;
  }
  @media (max-width: 860px) {
    .article-toc {
      padding: 0 0 1rem;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
    .toc-label {
      margin-left: 0;
    }
    ol {
      display: flex;
      flex-wrap: wrap;
      gap: 0 1.25rem;
    }
  }
</style>
