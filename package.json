{
  "name": "pulse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "npm run typecheck:tooling && astro check",
    "content:check": "node scripts/validate-content.ts",
    "guides:assets:test": "node --test tests/guide-assets.test.ts",
    "guides:ledger:check": "node scripts/validate-tools-guides-ledgers.ts",
    "guides:ledger:test": "node --test tests/tools-guides-ledger.test.ts",
    "translations:check": "node scripts/validate-translations.ts",
    "translations:test": "node --test tests/translations.test.ts",
    "editorial:check": "node scripts/validate-editorial-batch.ts",
    "illustration:check": "node scripts/validate-illustration-batch.ts",
    "illustration:decision": "node scripts/resolve-illustration-generation.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run check && astro build && pagefind --site dist",
    "verify": "npm run lint && npm run format:check && npm run content:check && npm run guides:ledger:check && npm run translations:check && npm run editorial:check && npm run editorial:run:check && npm run illustration:check && npm run build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "preview": "astro preview",
    "translations:pages:test": "node --test tests/french-pages.test.ts",
    "translations:batch": "node scripts/translation-batch.ts",
    "translations:batch:test": "node --test tests/translation-batch.test.ts",
    "typecheck:tooling": "tsc -p tsconfig.tooling.json",
    "test": "node --test tests/*.test.ts",
    "editorial:run:check": "node scripts/check-daily-news-run.ts",
    "editorial:run:test": "node --test tests/daily-news-run.test.ts"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/sitemap": "3.7.4",
    "astro": "^7.4.0",
    "astro-expressive-code": "0.44.3",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "jiti": "2.7.0",
    "pagefind": "1.5.2",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.1",
    "typescript-eslint": "8.72.0"
  }
}
