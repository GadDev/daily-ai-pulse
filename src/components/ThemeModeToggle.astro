---
import { messages, type Locale } from '../lib/i18n';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const text = messages[locale];
---

<fieldset class="theme-mode-toggle" aria-labelledby="theme-mode-label">
  <legend id="theme-mode-label" class="theme-mode-toggle__label">
    {text.themeMode}
  </legend>
  <div class="theme-mode-toggle__options">
    <label class="theme-mode-toggle__option">
      <input
        type="radio"
        name="theme-mode"
        value="light"
        class="theme-mode-toggle__input"
        data-theme-mode="light"
      />
      <span class="theme-mode-toggle__option-text">{text.themeLight}</span>
    </label>
    <label class="theme-mode-toggle__option">
      <input
        type="radio"
        name="theme-mode"
        value="dark"
        class="theme-mode-toggle__input"
        data-theme-mode="dark"
      />
      <span class="theme-mode-toggle__option-text">{text.themeDark}</span>
    </label>
    <label class="theme-mode-toggle__option">
      <input
        type="radio"
        name="theme-mode"
        value="system"
        class="theme-mode-toggle__input"
        data-theme-mode="system"
      />
      <span class="theme-mode-toggle__option-text">{text.themeSystem}</span>
    </label>
  </div>
</fieldset>

<style>
  .theme-mode-toggle {
    border: none;
    padding: 0;
    margin: 0;
  }

  .theme-mode-toggle__label {
    display: block;
    font:
      600 0.85rem/1.3 ui-sans-serif,
      system-ui,
      sans-serif;
    color: var(--ink);
    margin-bottom: 0.75rem;
  }

  .theme-mode-toggle__options {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .theme-mode-toggle__option {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--line);
    border-radius: 0;
    background: var(--surface);
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .theme-mode-toggle__option:hover {
    border-color: var(--muted);
    background: var(--surface-alt);
  }

  .theme-mode-toggle__option:has(:focus-visible) {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
    border-color: var(--focus-ring);
  }

  .theme-mode-toggle__input {
    width: 1.125rem;
    height: 1.125rem;
    accent-color: var(--terracotta);
    flex: 0 0 auto;
  }

  .theme-mode-toggle__option-text {
    font:
      400 0.95rem/1.3 Georgia,
      'Times New Roman',
      serif;
    color: var(--ink);
  }

  .theme-mode-toggle__option:has(:checked) {
    border-color: var(--terracotta);
    background: var(--accent-soft);
  }

  [data-theme='dark'] .theme-mode-toggle__option:has(:checked) {
    background: var(--cuivre-container);
    border-color: var(--cuivre-clair);
  }

  @media (min-width: 640px) {
    .theme-mode-toggle__options {
      flex-direction: row;
      flex-wrap: wrap;
    }

    .theme-mode-toggle__option {
      flex: 1;
      min-width: 0;
      justify-content: center;
    }
  }
</style>

<script>
  // Initialize immediately (before page-load) to avoid flash
  (function () {
    const html = document.documentElement;
    const storedTheme = localStorage.getItem('theme');
    const useSystem = localStorage.getItem('theme-system') !== 'false';
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

    let currentTheme;
    if (useSystem) {
      currentTheme = prefersDark ? 'dark' : 'light';
    } else if (storedTheme) {
      currentTheme = storedTheme;
    } else {
      currentTheme = prefersDark ? 'dark' : 'light';
    }

    html.setAttribute('data-theme', currentTheme);

    // Update ThemeToggle if present
    const themeToggle = document.querySelector('[data-theme-toggle]');
    if (themeToggle) {
      themeToggle.setAttribute('aria-pressed', currentTheme === 'dark' ? 'true' : 'false');
    }
  })();

  document.addEventListener('astro:page-load', () => {
    const inputs = document.querySelectorAll<HTMLInputElement>('[data-theme-mode]');
    if (!inputs.length) return;

    const html = document.documentElement;

    const applyTheme = (mode: 'light' | 'dark' | 'system') => {
      let theme: 'light' | 'dark';
      if (mode === 'system') {
        theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      } else {
        theme = mode;
      }
      html.setAttribute('data-theme', theme);

      // Update all theme toggles on the page (header + settings)
      document.querySelectorAll('[data-theme-toggle]').forEach((toggle) => {
        toggle.setAttribute('aria-pressed', theme === 'dark' ? 'true' : 'false');
      });
    };

    const updateSelection = () => {
      const storedTheme = localStorage.getItem('theme');
      const useSystem = localStorage.getItem('theme-system') !== 'false';
      const currentMode: 'light' | 'dark' | 'system' = useSystem
        ? 'system'
        : (storedTheme as 'light' | 'dark' | 'system') || 'system';

      inputs.forEach((input) => {
        const value = input.getAttribute('data-theme-mode');
        if (value) {
          input.checked = value === currentMode;
        }
      });
    };

    // Initialize from localStorage
    const storedTheme = localStorage.getItem('theme');
    const useSystem = localStorage.getItem('theme-system') !== 'false';
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

    let currentMode: 'light' | 'dark' | 'system';
    if (useSystem) {
      currentMode = 'system';
    } else if (storedTheme) {
      currentMode = storedTheme as 'light' | 'dark';
    } else {
      currentMode = prefersDark ? 'dark' : 'light';
    }

    applyTheme(currentMode);
    updateSelection();

    // Handle button clicks
    inputs.forEach((input) => {
      input.addEventListener('change', () => {
        if (!input.checked) return;

        const value = input.getAttribute('data-theme-mode');
        if (!value) return;

        if (value === 'system') {
          localStorage.setItem('theme-system', 'true');
          localStorage.removeItem('theme');
        } else {
          localStorage.setItem('theme', value);
          localStorage.setItem('theme-system', 'false');
        }

        applyTheme(value as 'light' | 'dark' | 'system');
        updateSelection();

        // Notify other components
        window.dispatchEvent(new CustomEvent('theme-change', { detail: { theme: value } }));
      });
    });

    // Listen for system theme changes
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
      if (localStorage.getItem('theme-system') !== 'false') {
        const newTheme = e.matches ? 'dark' : 'light';
        html.setAttribute('data-theme', newTheme);
        document.querySelectorAll('[data-theme-toggle]').forEach((toggle) => {
          toggle.setAttribute('aria-pressed', newTheme === 'dark' ? 'true' : 'false');
        });
      }
    });

    // Listen for theme changes from ThemeToggle
    window.addEventListener('theme-change', () => {
      updateSelection();
    });
  });
</script>
