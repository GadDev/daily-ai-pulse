---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import StoryListRow from '../../components/StoryListRow.astro';

const base = import.meta.env.BASE_URL;
const stories = (await getCollection('stories'))
  .filter((story) => story.data.category === 'research')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title="Research — Pulse" description="AI research worth paying attention to.">
  <section class="issue-head">
    <p class="eyebrow">ARCHIVE / RESEARCH</p>
    <h1>Research</h1>
    <p>Papers, training, inference, memory, evals, and safety — filtered for signal.</p>
  </section>

  <CategoryNav active="research" />

  <section class="archive-list">
    <SectionHeading title="Latest research" />
    {stories.map((story) => (
      <StoryListRow
        title={story.data.title}
        description={story.data.description}
        href={`${base}stories/${story.id}/`}
        date={story.data.date.toLocaleDateString('en-GB')}
        meta={`${story.data.type} · ${story.data.difficulty} · evidence/${story.data.evidence} · signal/${story.data.signal}`}
      />
    ))}
  </section>
</BaseLayout>

<style>
  .archive-list{padding:3rem 0 1rem}
</style>
