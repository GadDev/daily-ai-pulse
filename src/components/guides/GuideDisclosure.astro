---
interface Props {
  disclosure: string;
}

const { disclosure } = Astro.props;
---

<aside class="guide-disclosure" aria-label="Affiliate disclosure">
  <strong>Commercial disclosure</strong>
  <p>{disclosure}</p>
</aside>
<style>
  .guide-disclosure { margin: 1.2rem 0; padding: 1rem 1.25rem; border: 1px solid var(--line); background: var(--surface-alt); }
  strong { display: block; color: var(--ink); font: 700 .72rem/1.4 ui-sans-serif, system-ui, sans-serif; text-transform: uppercase; letter-spacing: .08em; }
  p { margin: .4rem 0 0; color: var(--muted); line-height: 1.5; }
</style>
