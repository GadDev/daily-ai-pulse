---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleToc from '../../components/ArticleToc.astro';
import PulseTake from '../../components/editorial/PulseTake.astro';
import Evidence from '../../components/editorial/Evidence.astro';
import TryThis from '../../components/editorial/TryThis.astro';
import EditorialQuote from '../../components/editorial/EditorialQuote.astro';
import { findEditionForStory, readingTime } from '../../lib/stories';
import { categories } from '../../lib/categories';

export async function getStaticPaths() {
  const stories = (await getCollection('stories'))
    .filter((story) => !story.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  const editions = await getCollection('pulse');

  return stories.map((story, index) => {
    const related = stories
      .filter((candidate) => candidate.id !== story.id)
      .map((candidate) => ({
        candidate,
        score:
          (candidate.data.category === story.data.category ? 2 : 0) +
          candidate.data.tags.filter((tag) => story.data.tags.includes(tag)).length,
      }))
      .filter(({ score }) => score > 0)
      .sort(
        (a, b) =>
          b.score - a.score || b.candidate.data.date.valueOf() - a.candidate.data.date.valueOf(),
      )
      .slice(0, 3)
      .map(({ candidate }) => candidate);

    return {
      params: { id: story.id },
      props: {
        story,
        edition: findEditionForStory(story.id, editions),
        newerStory: index > 0 ? stories[index - 1] : undefined,
        olderStory: index < stories.length - 1 ? stories[index + 1] : undefined,
        related,
      },
    };
  });
}

interface Props {
  story: CollectionEntry<'stories'>;
  edition?: CollectionEntry<'pulse'>;
  newerStory?: CollectionEntry<'stories'>;
  olderStory?: CollectionEntry<'stories'>;
  related: CollectionEntry<'stories'>[];
}

const { story, edition, newerStory, olderStory, related } = Astro.props;
const { Content, headings } = await render(story);
const base = import.meta.env.BASE_URL;
const tocItems = headings
  .filter((heading) => heading.depth === 2 || heading.depth === 3)
  .map((heading) => ({ id: heading.slug, label: heading.text }));
const publishedDate = story.data.date.toLocaleDateString('en-GB', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
const editionLabel = edition?.data.date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  timeZone: 'UTC',
});
const primarySource = story.data.sources[0];
const categoryTitle = categories[story.data.category].title;
const typeLabel = story.data.type.replace('-', ' ');
const imageSrc = story.data.image.startsWith('/')
  ? `${base}${story.data.image.slice(1)}`
  : story.data.image;
---

<BaseLayout
  title={`${story.data.title} — Pulse`}
  description={story.data.description}
  image={story.data.image}
  type="article"
  publishedTime={story.data.date.toISOString()}
  section={story.data.category}
  tags={story.data.tags}
>
  <article class="article-shell">
    <header class="article-header">
      {edition && (
        <a class="back-link" href={`${base}pulse/${edition.id}/`}>
          <span aria-hidden="true">←</span> Back to {editionLabel} edition
        </a>
      )}
      <p class="eyebrow article-eyebrow">
        <span>{categoryTitle}</span>
        <span aria-hidden="true">/</span>
        <span class="sr-only">, </span>
        <span>{typeLabel}</span>
      </p>
      <h1>{story.data.title}</h1>
      <p class="dek">{story.data.description}</p>

      <div class="article-meta">
        <ul class="meta-list" aria-label="Article metadata">
          <li>
            <time datetime={story.data.date.toISOString()}>{publishedDate}</time>
          </li>
          <li>By The Daily AI Pulse</li>
          <li>{readingTime(story)}</li>
          <li>
            Primary source:
            <a class="source-link" href={primarySource.url} target="_blank" rel="noreferrer">
              <span class="source-label">{primarySource.label}</span>
              <span aria-hidden="true"> ↗</span>
              <span class="sr-only"> (opens in a new tab)</span>
            </a>
          </li>
        </ul>
        <div class="meta-actions">
          <button type="button" class="copy-link" data-copy-link hidden>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1" />
              <path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" />
            </svg>
            <span class="sr-only">Copy link to this article</span>
          </button>
          <span class="copy-status" role="status" data-copy-status></span>
          {story.data.signal === 'high' && (
            <span class="signal-badge">
              High signal<span class="signal-dot" aria-hidden="true"></span>
            </span>
          )}
        </div>
      </div>
    </header>

    <figure class="article-hero">
      <img src={imageSrc} alt={story.data.imageAlt} loading="eager" />
    </figure>

    <div class:list={['article-layout', { 'article-layout--no-toc': tocItems.length === 0 }]}>
      {tocItems.length > 0 && (
        <aside class="article-aside">
          <ArticleToc items={tocItems} />
        </aside>
      )}

      <div class="article-main">
        <div class="prose">
          <Content components={{ PulseTake, Evidence, TryThis, EditorialQuote }} />
        </div>

        {story.data.sources.length > 0 && (
          <section class="sources" aria-labelledby="sources-title">
            <p class="eyebrow">VERIFICATION</p>
            <h2 id="sources-title">Sources</h2>
            <dl class="verification">
              <div>
                <dt>Evidence</dt>
                <dd>{story.data.evidence}</dd>
              </div>
              <div>
                <dt>Signal</dt>
                <dd>{story.data.signal}</dd>
              </div>
              <div>
                <dt>Difficulty</dt>
                <dd>{story.data.difficulty}</dd>
              </div>
            </dl>
            <ol>
              {story.data.sources.map((source) => (
                <li>
                  <a href={source.url} target="_blank" rel="noreferrer">
                    {source.label}
                  </a>
                </li>
              ))}
            </ol>
          </section>
        )}
      </div>
    </div>

    {related.length > 0 && (
      <section class="related" aria-labelledby="related-title">
        <p class="eyebrow">KEEP READING</p>
        <h2 id="related-title">Related stories</h2>
        <div class="related-grid">
          {related.map((item) => (
            <article>
              <p class="label">
                {item.data.category} / {item.data.type}
              </p>
              <h3>
                <a href={`${base}stories/${item.id}/`}>{item.data.title}</a>
              </h3>
              <p>{item.data.description}</p>
            </article>
          ))}
        </div>
      </section>
    )}

    {(olderStory || newerStory) && (
      <nav class="article-pager" aria-label="Article navigation">
        <div>
          {olderStory && (
            <a href={`${base}stories/${olderStory.id}/`}>
              <span>← Older</span>
              <strong>{olderStory.data.title}</strong>
            </a>
          )}
        </div>
        <div class="next">
          {newerStory && (
            <a href={`${base}stories/${newerStory.id}/`}>
              <span>Newer →</span>
              <strong>{newerStory.data.title}</strong>
            </a>
          )}
        </div>
      </nav>
    )}
  </article>
</BaseLayout>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-copy-link]');
  const status = document.querySelector<HTMLElement>('[data-copy-status]');

  if (button && status && navigator.clipboard) {
    button.hidden = false;
    let timer = 0;
    button.addEventListener('click', async () => {
      const url = new URL(window.location.href);
      url.hash = '';
      try {
        await navigator.clipboard.writeText(url.toString());
        status.textContent = 'Link copied';
      } catch {
        status.textContent = 'Copy failed';
      }
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        status.textContent = '';
      }, 2500);
    });
  }
</script>

<style>
  .article-shell {
    max-width: none;
    margin: 0 auto;
  }
  .article-header {
    max-width: 66rem;
    margin-left: clamp(0px, 8vw, 6.5rem);
    padding: 1.4rem 0 1.4rem;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    color: var(--terracotta);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 0.95rem;
    text-decoration: none;
  }
  .back-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .article-eyebrow {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.75rem;
    margin: 0.5rem 0 0;
    font:
      700 0.72rem/1.2 Inter,
      ui-sans-serif,
      system-ui,
      sans-serif;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--terracotta);
  }
  .article-header h1 {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2.4rem, 4.4vw, 3.4rem);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.035em;
    max-width: 30ch;
    margin: 0.9rem 0 1.1rem;
  }
  .article-header .dek {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    line-height: 1.35;
    max-width: 46rem;
    margin: 0;
    color: var(--muted);
  }
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    align-items: center;
    justify-content: space-between;
    margin-top: 1.25rem;
    font:
      500 0.72rem/1.3 Inter,
      ui-sans-serif,
      system-ui,
      sans-serif;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .meta-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .meta-list li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
  }
  .meta-list li + li {
    margin-left: 1rem;
    padding-left: 1rem;
    border-left: 1px solid var(--line);
  }
  .source-link {
    display: inline-flex;
    align-items: center;
    max-width: 24ch;
    min-height: 44px;
    color: var(--terracotta);
    font-weight: 700;
    text-underline-offset: 0.2em;
  }
  .source-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .meta-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .copy-link {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }
  .copy-link[hidden] {
    display: none;
  }
  .copy-link:hover {
    color: var(--terracotta);
  }
  .copy-link svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .copy-status {
    color: var(--terracotta);
    font-weight: 700;
  }
  .signal-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.66rem;
    font-weight: 700;
    color: var(--ink);
  }
  .signal-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--terracotta);
  }
  .article-hero {
    margin: 0.5rem 0 0;
    border-radius: 3px;
    overflow: hidden;
    background: var(--surface-alt);
  }
  .article-hero img {
    display: block;
    width: 100%;
    aspect-ratio: 21/9;
    object-fit: cover;
  }
  .article-layout {
    display: grid;
    grid-template-columns: 13.5rem minmax(0, 42rem);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
    padding: 3rem 0 1rem clamp(0px, 4vw, 3.5rem);
  }
  .article-layout--no-toc {
    grid-template-columns: minmax(0, 42rem);
  }
  .article-aside {
    position: sticky;
    top: 7rem;
  }
  .prose {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.13rem;
    line-height: 1.7;
    margin-top: 0;
  }
  :global(.prose > :first-child) {
    margin-top: 0;
  }
  :global(.prose h2),
  :global(.prose h3) {
    scroll-margin-top: 6rem;
  }
  :global(.prose h2) {
    font-size: 2rem;
    line-height: 1.05;
    margin: 3.3rem 0 1rem;
    letter-spacing: -0.025em;
  }
  :global(.prose h3) {
    font-size: 1.4rem;
    line-height: 1.15;
    margin: 2.2rem 0 0.8rem;
  }
  :global(.prose p) {
    margin: 0 0 1.35rem;
  }
  :global(.prose a) {
    text-underline-offset: 0.18em;
  }
  :global(.prose blockquote) {
    margin: 2.5rem 0;
    padding-left: 1.4rem;
    border-left: 3px solid var(--line);
    font-size: 1.15rem;
    line-height: 1.6;
    font-style: italic;
  }
  :global(.prose pre) {
    overflow: auto;
    padding: 1.2rem;
    border: 1px solid var(--line);
    background: var(--surface);
    font-size: 0.88rem;
  }
  .sources {
    margin-top: 4rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--ink);
  }
  .sources h2,
  .related h2 {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 2rem;
    margin: 0.45rem 0 1.2rem;
  }
  .sources ol {
    margin: 0;
    padding-left: 1.25rem;
    display: grid;
    gap: 0.75rem;
  }
  .sources a {
    text-underline-offset: 0.2em;
  }
  .verification {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin: 0 0 1.2rem;
    font:
      600 0.7rem/1.2 ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .verification div {
    display: flex;
    gap: 0.5rem;
  }
  .verification dt {
    color: var(--muted);
  }
  .verification dd {
    margin: 0;
  }
  .related {
    margin-top: 4.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--ink);
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }
  .related-grid article {
    padding: 1.2rem 1.4rem 1.4rem 0;
    border-bottom: 1px solid var(--line);
  }
  .related-grid article + article {
    padding-left: 1.4rem;
    border-left: 1px solid var(--line);
  }
  .related-grid h3 {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.35rem;
    line-height: 1.08;
    margin: 0.4rem 0 0.65rem;
  }
  .related-grid h3 a {
    text-decoration: none;
  }
  .related-grid article > p:not(.label) {
    margin: 0;
    color: var(--muted);
    line-height: 1.5;
    font-size: 0.92rem;
  }
  .article-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin: 4rem 0 1rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--line);
  }
  .article-pager a {
    display: grid;
    gap: 0.45rem;
    text-decoration: none;
  }
  .article-pager span {
    font:
      600 0.68rem/1 ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .article-pager strong {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.15rem;
    line-height: 1.18;
    font-weight: 600;
  }
  .article-pager .next {
    text-align: right;
  }
  @media (max-width: 860px) {
    .article-header {
      margin-left: 0;
    }
    .article-layout {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding-left: 0;
    }
    .article-aside {
      position: static;
      order: -1;
    }
    .related-grid {
      grid-template-columns: 1fr;
    }
    .related-grid article + article {
      padding-left: 0;
      border-left: 0;
    }
  }
  @media (max-width: 620px) {
    .article-hero img {
      aspect-ratio: 16/9;
    }
    .meta-list li + li {
      margin-left: 0;
      padding-left: 0;
      border-left: 0;
    }
    .meta-list li {
      margin-right: 1rem;
    }
    .article-pager {
      grid-template-columns: 1fr;
    }
    .article-pager .next {
      text-align: left;
    }
  }
</style>
