---
interface Item {
  date: string;
  title: string;
  href: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<section class="latest-pulse" aria-labelledby="latest-pulse-title">
  <div class="section-heading">
    <h2 id="latest-pulse-title">Latest from The Pulse</h2>
    <a href={`${import.meta.env.BASE_URL}pulse/`}>View all →</a>
  </div>
  <ol>
    {items.map((item) => (
      <li>
        <time>{item.date}</time>
        <a href={item.href}>{item.title}</a>
      </li>
    ))}
  </ol>
</section>

<style>
  .latest-pulse{padding:3rem 0}
  .section-heading{display:flex;align-items:baseline;justify-content:space-between;gap:1rem}
  h2{font-family:Georgia,'Times New Roman',serif;font-size:1.6rem;margin:0 0 1rem}
  .section-heading>a{font-size:.82rem;text-decoration:none}
  ol{list-style:none;padding:0;margin:0;border-top:1px solid var(--line)}
  li{display:grid;grid-template-columns:9rem 1fr;gap:1.25rem;padding:1rem 0;border-bottom:1px solid var(--line)}
  time{font-size:.72rem;letter-spacing:.06em;color:var(--ink-muted);text-transform:uppercase}
  li>a{text-decoration:none;font-weight:600}
  @media(max-width:620px){li{grid-template-columns:1fr;gap:.3rem}}
</style>
