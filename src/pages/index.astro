---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BigStory from '../components/BigStory.astro';
import LatestPulseList from '../components/LatestPulseList.astro';
import StoryCard from '../components/StoryCard.astro';

type Story = CollectionEntry<'stories'>;
type StoryCategory = Story['data']['category'];
type Section = {
  label: string;
  category: StoryCategory;
  image: string;
  alt: string;
};

const base = import.meta.env.BASE_URL;
const stories = (await getCollection('stories')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const editions = (await getCollection('pulse')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const bigStory = stories.find((story) => story.data.featured) ?? stories[0];
const latestFor = (category: StoryCategory): Story | undefined =>
  stories.find((story) => story.data.category === category);

const sections: Section[] = [
  {
    label: 'Research',
    category: 'research',
    image: `${base}images/editorial/research.svg`,
    alt: 'Layered mountain landscape',
  },
  {
    label: 'Tools',
    category: 'tools',
    image: `${base}images/editorial/tools.svg`,
    alt: 'Abstract geometric planes',
  },
  {
    label: 'AI in Practice',
    category: 'practice',
    image: `${base}images/editorial/practice.svg`,
    alt: 'Warm minimal workspace',
  },
  {
    label: 'Curious',
    category: 'curious',
    image: `${base}images/editorial/curious.svg`,
    alt: 'Abstract desert dunes',
  },
];

const readingTime = (story: Story) =>
  story.data.type === 'deep-dive'
    ? '8 min read'
    : story.data.type === 'briefing'
      ? '4 min read'
      : '3 min read';

const latestPulseItems = editions.slice(0, 5).map((edition) => ({
  date: edition.data.date
    .toLocaleDateString('en-US', {
      month: 'short',
      day: '2-digit',
      year: 'numeric',
    })
    .toUpperCase(),
  title: edition.data.title.replace(/^The Daily AI Pulse\s*[—-]\s*/i, ''),
  href: `${base}pulse/${edition.id}/`,
}));
---

<BaseLayout title="The Daily AI Pulse — Signal over noise in AI">
  {bigStory && (
    <BigStory
      label="BIG STORY"
      title={bigStory.data.title}
      description={bigStory.data.description}
      href={`${base}stories/${bigStory.id}/`}
      image={`${base}images/editorial/hero.svg`}
      imageAlt="Monumental geometric architecture in warm evening light"
    />
  )}

  <section id="categories" class="editorial-grid" aria-label="Latest stories by desk">
    {sections.map(({ label, category, image, alt }) => {
      const story = latestFor(category);
      return (
        story && (
          <StoryCard
            label={label}
            title={story.data.title}
            href={`${base}stories/${story.id}/`}
            image={image}
            imageAlt={alt}
            meta={readingTime(story)}
          />
        )
      );
    })}
  </section>

  {latestPulseItems.length > 0 && <LatestPulseList items={latestPulseItems} />}
</BaseLayout>

<style>
  .editorial-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.35rem;
    padding: 3rem 0 4.5rem;
  }

  @media (max-width: 900px) {
    .editorial-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .editorial-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }
</style>
