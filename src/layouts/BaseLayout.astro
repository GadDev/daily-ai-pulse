---
import '../styles/global.css';
import SearchButton from '../components/SearchButton.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  section?: string;
  tags?: string[];
}

const {
  title = 'The Daily AI Pulse',
  description = 'Signal over noise in AI.',
  image,
  type = 'website',
  publishedTime,
  section,
  tags = [],
} = Astro.props;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
const isActive = (path: string) => currentPath === path || currentPath.startsWith(`${path}/`);
const site = Astro.site ?? new URL('https://gaddev.github.io');
const canonicalUrl = new URL(currentPath, site).toString();
const rssUrl = new URL(`${base}rss.xml`, site).toString();
const absoluteImage = image
  ? new URL(image.startsWith('/') ? `${base}${image.slice(1)}` : image, site).toString()
  : undefined;
const socialImage = absoluteImage ?? new URL(`${base}images/editorial/hero.svg`, site).toString();
const structuredData =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: title,
        description,
        mainEntityOfPage: canonicalUrl,
        datePublished: publishedTime,
        articleSection: section,
        keywords: tags.join(', '),
        image: socialImage,
        publisher: {
          '@type': 'Organization',
          name: 'The Daily AI Pulse',
          url: new URL(base, site).toString(),
        },
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: 'The Daily AI Pulse',
        url: new URL(base, site).toString(),
        description: 'Signal over noise in AI.',
      };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3ebdd" />
    <link rel="icon" href={`${base}favicon.ico`} sizes="16x16 24x24 32x32 48x48 64x64" />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}icons/favicon-16x16.png`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}icons/favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="48x48" href={`${base}icons/favicon-48x48.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="The Daily AI Pulse RSS" href={rssUrl} />

    <meta property="og:site_name" content="The Daily AI Pulse" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {type === 'article' && section && <meta property="article:section" content={section} />}
    {type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <div class="brand-block">
          <a class="brand" href={base} aria-label="The Daily AI Pulse home">
            The Daily AI Pulse<span class="brand-dot" aria-hidden="true"></span>
          </a>
          <p class="brand-tagline">Ideas Tools People Impact</p>
        </div>

        <nav class="site-nav" aria-label="Primary navigation">
          <a class:list={{ active: currentPath === base }} href={base}>
            Today
          </a>
          <a class:list={{ active: isActive(`${base}pulse`) }} href={`${base}pulse/`}>
            Pulse
          </a>
          <a class:list={{ active: isActive(`${base}categories`) }} href={`${base}categories/`}>
            Categories
            <svg class="nav-chevron" viewBox="0 0 12 12" aria-hidden="true">
              <path d="m2.5 4.5 3.5 3.5 3.5-3.5"></path>
            </svg>
          </a>
          <a class:list={{ active: isActive(`${base}about`) }} href={`${base}about/`}>
            About
          </a>
        </nav>

        <div class="site-actions">
          <SearchButton />
          <a class="subscribe-button" href={`${base}subscribe/`}>
            Subscribe
          </a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__grid">
        <section class="footer-publication">
          <a class="brand brand--footer" href={base}>
            The Daily AI Pulse
          </a>
          <p class="footer-copy footer-copy--lead">Clear. Curated. Consequential.</p>
          <p class="footer-copy">
            A daily briefing on the AI developments that matter to engineers, from research and
            tools to real-world impact.
          </p>
          <div class="footer-links-inline" aria-label="Publication links">
            <a href="https://github.com/GadDev/daily-ai-pulse" target="_blank" rel="noreferrer">
              GitHub ↗
            </a>
            <a href={`${base}rss.xml`}>RSS feed</a>
          </div>
        </section>

        <section>
          <h2>Explore</h2>
          <a href={base}>Home</a>
          <a href={`${base}pulse/`}>Latest Pulse</a>
          <a href={`${base}categories/`}>Categories</a>
          <a href={`${base}about/`}>About</a>
          <a href={`${base}methodology/`}>Methodology</a>
          <a href={`${base}rss.xml`}>RSS feed</a>
        </section>

        <section>
          <h2>Categories</h2>
          <a href={`${base}research/`}>Research</a>
          <a href={`${base}models/`}>Models & Releases</a>
          <a href={`${base}engineering/`}>AI Engineering</a>
          <a href={`${base}tools/`}>Dev Tools</a>
          <a href={`${base}practice/`}>AI in Practice</a>
          <a href={`${base}workflows/`}>Workflows</a>
          <a href={`${base}business/`}>Business & Industry</a>
          <a href={`${base}curious/`}>Curious AI</a>
        </section>

        <section class="footer-subscribe">
          <h2>Subscribe</h2>
          <p class="footer-copy">Get each edition in your feed reader.</p>
          <a class="footer-rss-button" href={`${base}rss.xml`}>
            Subscribe with RSS →
          </a>
          <p class="footer-fineprint">Email delivery is being planned.</p>
        </section>
      </div>

      <div class="site-footer__bottom">
        <span>© 2026 Alexandre Gadaix. All rights reserved for editorial content.</span>
        <span class="footer-legal">
          <a href={`${base}privacy/`}>Privacy</a>
          <a href={`${base}terms/`}>Terms</a>
          <a href={`${base}contact/`}>Contact</a>
        </span>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: static;
    background: transparent;
    border-bottom: 0;
    backdrop-filter: none;
  }
  .site-header .site-header__inner {
    width: min(1180px, 92vw);
    min-height: 88px;
    border-bottom: 1px solid var(--line);
  }
  .brand-block {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.9rem 0 0.8rem;
  }
  .site-header .brand {
    font-size: 1.7rem;
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .brand-dot {
    display: inline-block;
    width: 0.3em;
    height: 0.3em;
    margin-left: 0.22em;
    border-radius: 50%;
    background: var(--terracotta);
    position: relative;
    top: -0.5em;
  }
  .brand-tagline {
    margin: 0;
    color: var(--muted);
    font-size: 0.6rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.28em;
    word-spacing: 0.55em;
    text-transform: uppercase;
  }
  .site-header .site-nav {
    gap: 2.4rem;
    font:
      1rem/1.2 Georgia,
      'Times New Roman',
      serif;
  }
  .site-header .site-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    border-bottom: 0;
    text-underline-offset: 0.6rem;
    text-decoration-thickness: 2px;
  }
  .site-header .site-nav a:hover {
    text-decoration-line: underline;
    text-decoration-color: var(--line);
  }
  .site-header .site-nav a.active {
    color: var(--ink);
    text-decoration-line: underline;
    text-decoration-color: var(--terracotta);
  }
  .nav-chevron {
    width: 0.7rem;
    height: 0.7rem;
    margin-left: 0.45rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .site-header .site-actions {
    gap: 2.4rem;
  }
  .site-header .subscribe-button {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 1.6rem;
    font:
      500 1rem/1 Georgia,
      'Times New Roman',
      serif;
  }
  @media (max-width: 960px) {
    .site-header .site-nav {
      gap: 1.6rem;
    }
    .site-header .site-actions {
      gap: 1rem;
    }
  }
  @media (max-width: 640px) {
    .site-header .subscribe-button {
      padding: 0 1.1rem;
    }
  }
</style>
