---
import '../styles/global.css';
const { title = 'Pulse', description = 'Signal over noise in AI.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="masthead">
      <a class="brand" href={import.meta.env.BASE_URL}>PULSE</a>
      <span>Signal over noise in AI</span>
    </header>
    <main><slot /></main>
  </body>
</html>
