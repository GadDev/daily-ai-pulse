---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const stories = (await getCollection('stories'))
  .filter((story) => story.data.category === 'research')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title="Research — Pulse" description="AI research worth paying attention to.">
  <section class="issue-head">
    <p class="eyebrow">ARCHIVE / RESEARCH</p>
    <h1>Research</h1>
    <p>Papers, training, inference, memory, evals, and safety — filtered for signal.</p>
  </section>

  <section class="grid">
    {stories.map((story) => (
      <article class="card">
        <p class="label">{story.data.type} · {story.data.difficulty}</p>
        <h2><a href={`${import.meta.env.BASE_URL}stories/${story.id}/`}>{story.data.title}</a></h2>
        <p>{story.data.description}</p>
        <div class="meta">
          {story.data.date.toLocaleDateString('en-GB')} · evidence/{story.data.evidence} · signal/{story.data.signal}
        </div>
      </article>
    ))}
  </section>
</BaseLayout>
