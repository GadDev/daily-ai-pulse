---
interface Props {
  href?: string;
  label?: string;
}

const { href = '#subscribe', label = 'Subscribe' } = Astro.props;
---

<a class="subscribe-button" href={href}>
  {label}
</a>

<style>
  .subscribe-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.72rem 1rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--surface);
    text-decoration: none;
    font-size: 0.86rem;
    font-weight: 700;
    line-height: 1;
  }
  .subscribe-button:hover {
    opacity: 0.9;
  }
</style>
