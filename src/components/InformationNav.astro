---
interface Props {
  active: string;
}
const { active } = Astro.props;
const base = import.meta.env.BASE_URL;
const pages = ['about', 'methodology', 'subscribe', 'contact', 'privacy', 'terms'];
---

<nav class="information-nav" aria-label="Publication information">
  {pages.map((page) => (
    <a
      class:list={{ active: active === page }}
      href={`${base}${page}/`}
      aria-current={active === page ? 'page' : undefined}
    >
      {page[0].toUpperCase() + page.slice(1)}
    </a>
  ))}
</nav>

<style>
  .information-nav {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.1rem;
    padding-top: 0.3rem;
  }
  a {
    display: block;
    padding: 0.65rem 0.8rem;
    border-left: 2px solid transparent;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.9rem;
  }
  a.active,
  a:hover,
  a:focus-visible {
    color: var(--accent);
    border-color: var(--accent);
  }
  @media (max-width: 700px) {
    .information-nav {
      flex-direction: row;
      gap: 0.2rem;
      overflow-x: auto;
      border-bottom: 1px solid var(--line);
    }
    a {
      white-space: nowrap;
      border-left: 0;
      border-bottom: 2px solid transparent;
    }
  }
</style>
