---
import { messages, type Locale } from '../lib/i18n';
interface Props {
  locale: Locale;
  storyId?: string;
  frenchAvailable?: boolean;
}
const { locale, storyId, frenchAvailable = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const englishHref = storyId ? `${base}stories/${storyId}/` : base;
const frenchHref = storyId ? `${base}fr/stories/${storyId}/` : `${base}fr/`;
const text = messages[locale];
---

<nav class="language-switcher" aria-label={text.languages} data-pagefind-ignore="all">
  <a
    href={englishHref}
    lang="en"
    hreflang="en"
    aria-label="English"
    title="English"
    aria-current={locale === 'en' ? 'page' : undefined}
  >
    <span aria-hidden="true">EN</span>
  </a>
  {!storyId || frenchAvailable || locale === 'fr' ? (
    <a
      href={frenchHref}
      lang="fr"
      hreflang="fr"
      aria-label="Français"
      title={!storyId ? 'Sélection en français' : 'Français'}
      aria-current={locale === 'fr' ? 'page' : undefined}
    >
      <span aria-hidden="true">FR</span>
    </a>
  ) : (
    <span
      class="language-unavailable"
      aria-disabled="true"
      aria-label="Français — no current translation"
      title={text.unavailable}
    >
      <span aria-hidden="true">FR</span>
    </span>
  )}
</nav>
<style>
  .language-switcher {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    padding: 2px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font:
      600 0.72rem/1 ui-sans-serif,
      system-ui,
      sans-serif;
  }
  .language-switcher > a,
  .language-unavailable {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    min-height: 44px;
    border-radius: 50%;
    color: var(--muted);
    text-decoration: none;
  }
  .language-switcher a[aria-current] {
    background: var(--ink);
    color: var(--surface);
  }
  .language-switcher a:not([aria-current]):hover {
    background: var(--surface-alt);
    color: var(--ink);
  }
  .language-unavailable {
    color: var(--muted);
    text-decoration: line-through;
    cursor: default;
  }
  .language-switcher a:focus-visible {
    outline: 2px solid var(--terracotta);
    outline-offset: 3px;
  }
</style>
