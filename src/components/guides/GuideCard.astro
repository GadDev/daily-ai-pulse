---
import type { Guide } from '../../lib/guides';
import { guideFormats, guideSeriesPath, verificationLabels } from '../../lib/guides';
import GuideDates from './GuideDates.astro';
interface Props {
  guide: Guide;
  variant?: 'card' | 'row' | 'feature';
}
const { guide, variant = 'card' } = Astro.props;
const base = import.meta.env.BASE_URL;
const Heading = variant === 'feature' ? 'h2' : 'h3';
---

<article class:list={['guide-card', `guide-card--${variant}`]}>
  {guide.data.image && (
    <img
      class="guide-card__image"
      src={`${base}${guide.data.image.slice(1)}`}
      alt={guide.data.imageAlt ?? ''}
      loading={variant === 'feature' ? 'eager' : 'lazy'}
      width="600"
      height="400"
    />
  )}
  <div class="guide-card__body">
    <p class="guide-card__eyebrow">
      {variant === 'feature' ? 'Featured / ' : ''}
      {guideFormats[guide.data.format].label} · {guide.data.difficulty}
    </p>
    <Heading>
      <a href={`${base}guides/${guide.id}/`}>{guide.data.title}</a>
    </Heading>
    <p class="guide-card__description">{guide.data.description}</p>
    {guide.data.series && (
      <a class="guide-card__series" href={guideSeriesPath(base, guide.data.series.id)}>
        {guide.data.series.title} · Part {guide.data.series.part}
      </a>
    )}
    <p class="guide-card__verification">{verificationLabels[guide.data.verification]}</p>
    <GuideDates guide={guide} />
  </div>
</article>
<style>
  .guide-card {
    min-width: 0;
    border-top: 1px solid var(--line);
    padding: 1.35rem 0;
  }
  .guide-card__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3/2;
    object-fit: cover;
    background: var(--surface-alt);
    margin-bottom: 1rem;
  }
  .guide-card__body {
    min-width: 0;
  }
  .guide-card__eyebrow {
    margin: 0;
    color: var(--terracotta);
    font:
      0.82rem/1.5 ui-sans-serif,
      system-ui,
      sans-serif;
  }
  h2,
  h3 {
    font:
      500 clamp(1.45rem, 2.2vw, 1.8rem)/1.17 Georgia,
      'Times New Roman',
      serif;
    letter-spacing: -0.02em;
    margin: 0.5rem 0 0.65rem;
    overflow-wrap: anywhere;
  }
  h2 a,
  h3 a {
    display: inline-block;
    min-height: 44px;
    text-decoration: none;
  }
  h2 a:hover,
  h3 a:hover {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  a:focus-visible {
    outline: 2px solid var(--terracotta);
    outline-offset: 3px;
  }
  .guide-card__description {
    margin: 0;
    color: var(--muted);
    line-height: 1.55;
  }
  .guide-card__series {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--terracotta);
    font-size: 0.85rem;
    text-underline-offset: 0.2em;
  }
  .guide-card__verification {
    font-size: 0.82rem;
    margin: 0.6rem 0 0;
    color: var(--muted);
  }
  .guide-card--row {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr);
    gap: 1.25rem;
  }
  .guide-card--row .guide-card__image {
    margin: 0;
  }
  .guide-card--feature {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    align-items: center;
    gap: 2rem;
    border-color: var(--ink);
    padding: 1.5rem 0 2rem;
  }
  .guide-card--feature .guide-card__image {
    margin: 0;
  }
  .guide-card--feature h2 {
    font-size: clamp(1.7rem, 3vw, 2.4rem);
  }
  @media (max-width: 640px) {
    .guide-card--row {
      grid-template-columns: 76px minmax(0, 1fr);
      gap: 1rem;
    }
    .guide-card--row .guide-card__image {
      aspect-ratio: 1;
    }
    .guide-card--feature {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .guide-card--feature .guide-card__image {
      max-height: 190px;
    }
  }
  @media (max-width: 390px) {
    .guide-card--row {
      grid-template-columns: 1fr;
    }
    .guide-card--row .guide-card__image {
      width: 96px;
      aspect-ratio: 3/2;
    }
  }
</style>
