---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryIllustration from './CategoryIllustration.astro';
import CategoryNav from './CategoryNav.astro';
import StoryListRow from './StoryListRow.astro';
import Pagination from './Pagination.astro';
import { categoryContent } from '../lib/category-content';
import {
  CATEGORY_PAGE_SIZE,
  archivePath,
  pageCount,
  sortArchive,
  type ArchiveOrder,
} from '../lib/pagination';
import { frenchCategories, frenchLabels, type Locale } from '../lib/i18n';
import type { CategoryConfig } from '../lib/categories';

type Story = CollectionEntry<'stories'>;

interface Props {
  config: CategoryConfig;
  locale?: Locale;
  currentPage?: number;
  order?: ArchiveOrder;
}

const { config, locale = 'en', currentPage = 1, order = 'latest' } = Astro.props;
const base = import.meta.env.BASE_URL;
const fr = locale === 'fr';
const title = fr ? frenchCategories[config.key] : config.title;
const allStories = sortArchive(await categoryContent(config.key, locale), order);
const totalPages = pageCount(allStories.length);
const stories = allStories.slice(
  (currentPage - 1) * CATEGORY_PAGE_SIZE,
  currentPage * CATEGORY_PAGE_SIZE,
);
const href = (page: number) => archivePath(base, config.key, locale, page, order);
// Language changes keep the category and order, clamping to the last available page.
const otherLocale = fr ? 'en' : 'fr';
const otherPages = pageCount((await categoryContent(config.key, otherLocale)).length);
const otherHref = archivePath(
  base,
  config.key,
  otherLocale,
  Math.min(currentPage, otherPages),
  order,
);
const storyCount = `${allStories.length} ${fr ? (allStories.length === 1 ? 'article' : 'articles') : allStories.length === 1 ? 'story' : 'stories'}`;
const mediaRows = 2;

const imageFor = (story: Story) =>
  story.data.image.startsWith('/') ? `${base}${story.data.image.slice(1)}` : story.data.image;

const evidenceLabels: Record<Story['data']['evidence'], string> = {
  strong: 'Strong evidence',
  primary: 'Primary source',
  preliminary: 'Preliminary evidence',
  anecdotal: 'Anecdotal report',
  unverified: 'Unverified claim',
};

const dateFormat = new Intl.DateTimeFormat(fr ? 'fr-FR' : 'en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});

const tagCounts = new Map<string, number>();
for (const story of allStories) {
  for (const tag of story.data.tags) tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
}
const topTags = [...tagCounts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .slice(0, 4)
  .map(([tag]) => tag.replaceAll('-', ' '));
---

<BaseLayout
  locale={locale}
  title={`${title}${currentPage > 1 ? ` — Page ${currentPage}` : ''}${order === 'oldest' ? (fr ? ' — Les plus anciens' : ' — Oldest') : ''} — Pulse`}
  description={
    fr ? `Les articles de la rubrique ${title}, traduits et relus en français.` : config.description
  }
  archiveLanguageHref={otherHref}
>
  <CategoryNav active={config.key} locale={locale} />

  <section class="category-head" aria-labelledby="category-title">
    <div class="category-copy">
      <p class="eyebrow">{fr ? `ARCHIVES / ${title}` : config.eyebrow}</p>
      <h1 id="category-title">{title}</h1>
      <p class="dek">
        {fr ? 'Une sélection d’articles traduits et relus en français.' : config.dek}
      </p>
      <p class="count">{storyCount}</p>
    </div>
    <CategoryIllustration
      title={
        fr
          ? `Réseau de sujets : ${title}`
          : `Network diagram of connected nodes representing ${title.toLowerCase()} topics`
      }
      labels={fr ? [] : topTags}
    />
  </section>

  <section class="archive-list" aria-labelledby="archive-title">
    <div class="list-header">
      <h2 id="archive-title">
        {fr ? `Articles : ${title}` : order === 'oldest' ? `${title} archive` : config.sectionTitle}
      </h2>
      <nav class="archive-sort" aria-label={fr ? 'Ordre des articles' : 'Story order'}>
        <a
          href={archivePath(base, config.key, locale)}
          aria-current={order === 'latest' ? 'true' : undefined}
        >
          {fr ? 'Les plus récents' : 'Latest'}
        </a>
        <a
          href={archivePath(base, config.key, locale, 1, 'oldest')}
          aria-current={order === 'oldest' ? 'true' : undefined}
        >
          {fr ? 'Les plus anciens' : 'Oldest'}
        </a>
      </nav>
    </div>
    {!allStories.length && (
      <p>
        {fr
          ? 'Aucun article en français n’est encore disponible dans cette rubrique.'
          : 'No stories have been published in this category yet.'}
      </p>
    )}
    <div data-story-rows>
      {stories.map((story, index) => (
        <StoryListRow
          title={story.data.title}
          description={story.data.description}
          href={`${base}${fr ? 'fr/' : ''}stories/${story.id}/`}
          date={dateFormat.format(story.data.date)}
          dateTime={story.data.date.toISOString().slice(0, 10)}
          desk={title}
          image={index < mediaRows ? imageFor(story) : undefined}
          imageAlt={index < mediaRows ? story.data.imageAlt : undefined}
          evidenceLabel={
            fr ? frenchLabels[story.data.evidence] : evidenceLabels[story.data.evidence]
          }
        />
      ))}
    </div>
    <Pagination current={currentPage} total={totalPages} href={href} locale={locale} />
  </section>
</BaseLayout>

<style>
  .archive-sort {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .archive-sort a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
    text-decoration: none;
  }
  .archive-sort a[aria-current] {
    text-decoration: underline;
    text-decoration-color: var(--terracotta);
    text-underline-offset: 0.4rem;
  }
  .archive-sort a:focus-visible {
    outline: 2px solid var(--terracotta);
    outline-offset: 3px;
  }

  .category-head {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
    padding: 1.6rem 0 1.4rem;
    border-bottom: 1px solid var(--ink);
  }
  .eyebrow {
    margin: 0;
    font-family: inherit;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--terracotta);
  }
  h1 {
    overflow-wrap: anywhere;
    margin: 0.3rem 0 0.6rem;
    font:
      400 clamp(3.4rem, 8vw, 5.75rem) / 0.95 Georgia,
      'Times New Roman',
      serif;
    letter-spacing: -0.04em;
  }
  .dek {
    margin: 0;
    max-width: 34rem;
    color: var(--ink-muted);
    font-family: var(--font-deck);
    font-size: clamp(1.15rem, 1.8vw, 1.4rem);
    line-height: 1.3;
  }
  .count {
    margin: 0.9rem 0 0;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .archive-list {
    padding: 1.5rem 0 1rem;
  }
  .list-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-bottom: 0.9rem;
  }
  .list-header h2 {
    margin: 0;
    font:
      400 clamp(1.7rem, 3vw, 2.2rem) / 1.1 Georgia,
      'Times New Roman',
      serif;
    letter-spacing: -0.02em;
  }
  @media (max-width: 720px) {
    .category-head {
      grid-template-columns: 1fr;
      padding-top: 1.4rem;
    }
  }
</style>
