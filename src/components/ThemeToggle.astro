---
import { messages, type Locale } from '../lib/i18n';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const text = messages[locale];

// Compute initial theme for SSR - will be overridden by client script
const isDark = Astro.cookies.has('theme') ? Astro.cookies.get('theme')?.value === 'dark' : false;
const initialAriaPressed = isDark ? 'true' : 'false';
---

<button
  class="theme-toggle"
  type="button"
  aria-label={text.themeToggleLabel}
  aria-pressed={initialAriaPressed as 'true' | 'false'}
  data-theme-toggle
>
  <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="5"></circle>
    <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
  </svg>
  <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: none;
    border-radius: 50%;
    background: var(--surface-alt);
    color: var(--muted);
    cursor: pointer;
    flex: 0 0 auto;
    transition:
      color 0.2s ease,
      background 0.2s ease;
  }

  .theme-toggle:hover {
    color: var(--ink);
    background: var(--line);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .theme-toggle__icon {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
    position: absolute;
  }

  .theme-toggle__icon--sun {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  .theme-toggle__icon--moon {
    opacity: 0;
    transform: rotate(-90deg) scale(0.8);
  }

  [data-theme='dark'] .theme-toggle__icon--sun,
  .theme-toggle[aria-pressed='true'] .theme-toggle__icon--sun {
    opacity: 0;
    transform: rotate(90deg) scale(0.8);
  }

  [data-theme='dark'] .theme-toggle__icon--moon,
  .theme-toggle[aria-pressed='true'] .theme-toggle__icon--moon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }
</style>

<script>
  // Initialize immediately (before page-load) to avoid flash
  (function () {
    const toggle = document.querySelector('[data-theme-toggle]');
    if (!toggle) return;

    const html = document.documentElement;
    const storedTheme = localStorage.getItem('theme');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const initialTheme = storedTheme ?? (prefersDark ? 'dark' : 'light');
    html.setAttribute('data-theme', initialTheme);
    toggle.setAttribute('aria-pressed', initialTheme === 'dark' ? 'true' : 'false');
  })();

  document.addEventListener('astro:page-load', () => {
    const toggle = document.querySelector('[data-theme-toggle]');
    if (!toggle) return;

    const html = document.documentElement;

    const updateAriaPressed = () => {
      const isDark = html.getAttribute('data-theme') === 'dark';
      toggle.setAttribute('aria-pressed', isDark ? 'true' : 'false');
    };

    updateAriaPressed();

    toggle.addEventListener('click', () => {
      const isDark = html.getAttribute('data-theme') === 'dark';
      const newTheme = isDark ? 'light' : 'dark';

      html.setAttribute('data-theme', newTheme);
      localStorage.setItem('theme', newTheme);
      localStorage.removeItem('theme-system');
      updateAriaPressed();

      // Notify other components
      window.dispatchEvent(new CustomEvent('theme-change', { detail: { theme: newTheme } }));
    });

    // Listen for system theme changes
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
      if (!localStorage.getItem('theme') && !localStorage.getItem('theme-system')) {
        const newTheme = e.matches ? 'dark' : 'light';
        html.setAttribute('data-theme', newTheme);
        updateAriaPressed();
      }
    });

    // Listen for theme changes from ThemeModeToggle
    window.addEventListener('theme-change', ((e: Event) => {
      const ce = e as CustomEvent;
      if (ce.detail?.theme) {
        html.setAttribute(
          'data-theme',
          ce.detail.theme === 'system'
            ? window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light'
            : ce.detail.theme,
        );
        updateAriaPressed();
      }
    }) as EventListener);
  });
</script>
