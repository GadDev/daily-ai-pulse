---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InformationNav from '../../components/InformationNav.astro';
---

<BaseLayout
  title="Content and code terms — The Daily AI Pulse"
  description="Read the publication's content and source-code licensing boundaries."
>
  <article class="information-page">
    <p class="eyebrow">USE & LICENSING</p>
    <h1>Use and attribution.</h1>
    <p class="lead">The publication’s articles and its software have different licensing terms.</p>
    <div class="information-grid">
      <InformationNav active="terms" />
      <div class="information-content">
        <section>
          <h2>Editorial content and artwork</h2>
          <p>
            Unless an item says otherwise, the original articles and editorial artwork are © 2026
            Alexandre Gadaix, all rights reserved. You may link to and quote short excerpts with
            attribution. Republishing complete articles or redistributing artwork requires
            permission.
          </p>
        </section>
        <section>
          <h2>Source code</h2>
          <p>
            The source code and technical project documentation are licensed under MIT. Third-party
            names and materials remain subject to their respective owners’ terms.
          </p>
        </section>
        <section>
          <h2>Full text</h2>
          <p>
            The{' '}
            <a href="https://github.com/GadDev/daily-ai-pulse/blob/main/CONTENT_LICENSE.md">
              content licensing file
            </a>{' '}
            defines this boundary; the{' '}
            <a href="https://github.com/GadDev/daily-ai-pulse/blob/main/LICENSE">MIT license</a>{' '}
            covers the code. For a permission request, use the{' '}
            <a href="https://github.com/GadDev/daily-ai-pulse/issues/new/choose">
              project contact route
            </a>
            .
          </p>
        </section>
      </div>
    </div>
  </article>
</BaseLayout>
