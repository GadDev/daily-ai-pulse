---
interface Props {
  title: string;
  description: string;
  href: string;
  date: string;
  dateTime?: string;
  category: string;
  evidence: string;
  readingTime: string;
  image?: string;
  imageAlt?: string;
}

const {
  title,
  description,
  href,
  date,
  dateTime,
  category,
  evidence,
  readingTime,
  image,
  imageAlt,
} = Astro.props;
---

<article class:list={['story-list-row', { 'with-image': Boolean(image) }]}>
  {image && (
    <a class="row-image" href={href} aria-label={`Read ${title}`}>
      <img src={image} alt={imageAlt ?? ''} loading="lazy" />
    </a>
  )}
  <div>
    <p class="eyebrow">{category}</p>
    <h2>
      <a href={href}>{title}</a>
    </h2>
    <p>{description}</p>
    <p class="row-meta">
      <a href={`${import.meta.env.BASE_URL}methodology/`}>{evidence}</a>
      <span>·</span>
      <span>{readingTime}</span>
    </p>
  </div>
  <div class="details">
    <time datetime={dateTime}>{date}</time>
  </div>
</article>

<style>
  .story-list-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(1.3rem, 3vw, 2.5rem);
    padding: 1.5rem 0;
    border-top: 1px solid var(--line);
  }
  .story-list-row.with-image {
    grid-template-columns: minmax(8rem, 0.23fr) minmax(0, 1fr) auto;
  }
  .row-image {
    display: block;
    background: var(--surface);
  }
  img {
    display: block;
    width: 100%;
    aspect-ratio: 1.45;
    object-fit: cover;
  }
  .eyebrow {
    margin: 0 0 0.45rem;
    color: var(--accent);
  }
  h2 {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.65rem;
    line-height: 1.05;
    margin: 0 0 0.55rem;
  }
  h2 a {
    text-decoration: none;
  }
  p:not(.eyebrow) {
    margin: 0;
    max-width: 62ch;
    color: var(--ink-muted);
    line-height: 1.5;
  }
  .row-meta {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.8rem !important;
    font-size: 0.75rem;
  }
  .details {
    display: grid;
    gap: 0.4rem;
    align-content: start;
    text-align: right;
    font-size: 0.76rem;
    color: var(--ink-muted);
  }
  @media (max-width: 640px) {
    .story-list-row,
    .story-list-row.with-image {
      grid-template-columns: 1fr;
    }
    .row-image {
      max-width: 22rem;
    }
    .details {
      text-align: left;
    }
  }
</style>
