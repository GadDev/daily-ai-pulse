---
interface Props {
  cite?: string;
}

const { cite } = Astro.props;
---

<figure class="editorial-quote">
  <blockquote><slot /></blockquote>
  {cite && <figcaption>— {cite}</figcaption>}
</figure>

<style>
  .editorial-quote {
    margin: 2.5rem 0;
    padding-left: 1.4rem;
    border-left: 3px solid var(--line);
  }
  blockquote {
    margin: 0;
    font-size: 1.2rem;
    line-height: 1.6;
    font-style: italic;
  }
  figcaption {
    margin-top: 0.8rem;
    color: var(--muted);
    font: 600 0.72rem/1.4 ui-monospace, SFMono-Regular, Menlo, monospace;
  }
</style>
