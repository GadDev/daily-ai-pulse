  label { display: inline-flex; align-items: center; gap: .35rem; cursor: pointer; border: 1px solid #b2a390; border-radius: .3rem; padding: .45rem .65rem; }
  label:has(input:checked) { background: #ede1d2; border-color: #8a4b35; }
  label:focus-within { outline: 2px solid #8a4b35; outline-offset: 3px; }
  input { accent-color: #8a4b35; }
