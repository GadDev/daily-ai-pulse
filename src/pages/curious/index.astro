---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const stories = (await getCollection('stories'))
  .filter((story) => story.data.category === 'curious')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title="Curious AI — Pulse" description="Weird, surprising, delightful, and counterintuitive AI stories.">
  <section class="issue-head">
    <p class="eyebrow">CATEGORY</p>
    <h1>Curious AI</h1>
    <p>Weird, surprising, delightful, and counterintuitive AI stories.</p>
  </section>

  <section class="grid">
    {stories.map((story) => (
      <article class="card">
        <p class="label">{story.data.type} · {story.data.difficulty}</p>
        <h2><a href={`${import.meta.env.BASE_URL}stories/${story.id}/`}>{story.data.title}</a></h2>
        <p>{story.data.description}</p>
        <div class="meta">{story.data.date.toLocaleDateString('en-GB')} · evidence/{story.data.evidence} · signal/{story.data.signal}</div>
      </article>
    ))}
  </section>
</BaseLayout>
