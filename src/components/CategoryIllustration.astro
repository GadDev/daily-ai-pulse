---
interface Props {
  title: string;
  labels?: string[];
}

const { title, labels = [] } = Astro.props;

const nodes = [
  { x: 60, y: 150, r: 9, tone: 'accent' },
  { x: 150, y: 100, r: 5, tone: 'ink' },
  { x: 118, y: 178, r: 4, tone: 'soft' },
  { x: 205, y: 120, r: 8, tone: 'accent' },
  { x: 232, y: 66, r: 3, tone: 'soft' },
  { x: 265, y: 168, r: 4, tone: 'ink' },
  { x: 300, y: 98, r: 4, tone: 'ink' },
  { x: 335, y: 128, r: 3, tone: 'soft' },
  { x: 372, y: 52, r: 4, tone: 'ink' },
  { x: 345, y: 178, r: 4, tone: 'ink' },
  { x: 428, y: 142, r: 9, tone: 'accent' },
  { x: 410, y: 82, r: 5, tone: 'soft' },
  { x: 462, y: 36, r: 11, tone: 'accent' },
  { x: 504, y: 72, r: 7, tone: 'soft' },
  { x: 470, y: 108, r: 4, tone: 'ink' },
];
const links: Array<[number, number]> = [
  [0, 2],
  [0, 3],
  [1, 3],
  [1, 4],
  [2, 5],
  [3, 5],
  [3, 6],
  [4, 6],
  [5, 9],
  [6, 7],
  [6, 8],
  [7, 9],
  [7, 10],
  [8, 11],
  [9, 10],
  [10, 14],
  [11, 12],
  [11, 14],
  [12, 13],
  [12, 14],
];
const dotted: Array<[number, number]> = [
  [0, 1],
  [3, 7],
  [10, 11],
  [13, 14],
];
---

<figure class="category-illustration">
  <svg viewBox="0 0 540 220" role="img" aria-labelledby="category-illustration-title">
    <title id="category-illustration-title">{title}</title>
    <path
      class="arc"
      d="M40 168 C 110 20, 330 -10, 500 30"
      fill="none"
      stroke-dasharray="1 5"
      stroke-linecap="round"
    ></path>
    {links.map(([a, b]) => (
      <line class="link" x1={nodes[a].x} y1={nodes[a].y} x2={nodes[b].x} y2={nodes[b].y} />
    ))}
    {dotted.map(([a, b]) => (
      <line
        class="link link--dotted"
        x1={nodes[a].x}
        y1={nodes[a].y}
        x2={nodes[b].x}
        y2={nodes[b].y}
        stroke-dasharray="1 4"
        stroke-linecap="round"
      />
    ))}
    {nodes.map((node) => (
      <circle class={`node node--${node.tone}`} cx={node.x} cy={node.y} r={node.r} />
    ))}
  </svg>
  {labels.length > 0 && (
    <ul class="labels" aria-label="Frequent topics in this category">
      {labels.map((label) => (
        <li>{label}</li>
      ))}
    </ul>
  )}
</figure>

<style>
  .category-illustration {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 1rem;
    margin: 0;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .arc {
    stroke: var(--line);
    stroke-width: 1.4;
  }
  .link {
    stroke: var(--ink-muted);
    stroke-width: 0.8;
    opacity: 0.45;
  }
  .link--dotted {
    stroke-width: 1.4;
    opacity: 0.7;
  }
  .node--accent {
    fill: var(--terracotta);
  }
  .node--ink {
    fill: var(--ink);
    opacity: 0.75;
  }
  .node--soft {
    fill: var(--ink-muted);
    opacity: 0.3;
  }
  .labels {
    list-style: none;
    margin: 0;
    padding: 0 0 0.2rem;
    max-width: 9rem;
    font-size: 0.6rem;
    line-height: 1.5;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .labels::after {
    content: '';
    display: block;
    width: 1.75rem;
    height: 1px;
    margin-top: 0.7rem;
    background: var(--ink-muted);
    opacity: 0.5;
  }
  @media (max-width: 720px) {
    .category-illustration {
      grid-template-columns: 1fr;
    }
  }
</style>
