---
const base = import.meta.env.BASE_URL;
const isCurrent = Astro.url.pathname === `${base}search/`;
---

<a
  class:list={['search-button', { current: isCurrent }]}
  href={`${base}search/`}
  aria-label="Search Pulse"
  aria-current={isCurrent ? 'page' : undefined}
>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="11" cy="11" r="6.5"></circle>
    <path d="m16 16 4 4"></path>
  </svg>
  <span class="search-label">Search</span>
</a>

<style>
  .search-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    padding: 0 0.9rem 0 1.6rem;
    color: var(--muted);
    border-radius: 999px;
    text-decoration: none;
    font:
      1rem/1 Georgia,
      'Times New Roman',
      serif;
  }
  .search-button::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    height: 1.9rem;
    border-left: 1px solid var(--line);
    transform: translateY(-50%);
  }
  svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
  }
  .search-button:hover,
  .search-button.current {
    color: var(--ink);
  }
  .search-button:focus-visible {
    color: var(--ink);
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  @media (max-width: 640px) {
    .search-button {
      padding: 0 0.75rem;
    }
    .search-button::before,
    .search-label {
      display: none;
    }
  }
</style>
