<script is:inline>
  // Run in the head before paint, then keep both controls in sync on static pages.
  (() => {
    const root = document.documentElement;
    const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');

    function readMode() {
      try {
        // Honor the old System setting even if it left a stale explicit theme behind.
        if (localStorage.getItem('theme-system') === 'true') return 'system';
        const saved = localStorage.getItem('theme');
        return saved === 'light' || saved === 'dark' ? saved : 'system';
      } catch {
        return 'system';
      }
    }

    let mode = readMode();

    function applyTheme() {
      const theme = mode === 'system' ? (systemTheme.matches ? 'dark' : 'light') : mode;
      root.dataset.theme = theme;
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute('content', theme === 'dark' ? '#000000' : '#f3ebdd');
      document.querySelectorAll('[data-theme-toggle]').forEach((toggle) => {
        toggle.setAttribute('aria-pressed', String(theme === 'dark'));
      });
      document.querySelectorAll('[data-theme-mode]').forEach((input) => {
        input.checked = input.dataset.themeMode === mode;
      });
    }

    function setMode(nextMode) {
      if (!['light', 'dark', 'system'].includes(nextMode)) return;
      mode = nextMode;
      try {
        if (mode === 'system') localStorage.removeItem('theme');
        else localStorage.setItem('theme', mode);
        // A missing theme now means System; no second preference flag is needed.
        localStorage.removeItem('theme-system');
      } catch {
        // Keep switching functional in memory when browser storage is unavailable.
      }
      applyTheme();
    }

    applyTheme();
    document.addEventListener('DOMContentLoaded', applyTheme, { once: true });

    document.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('[data-theme-toggle]')) {
        setMode(root.dataset.theme === 'dark' ? 'light' : 'dark');
      }
    });

    document.addEventListener('change', (event) => {
      const input = event.target;
      if (
        input instanceof HTMLInputElement &&
        input.matches('[data-theme-mode]') &&
        input.checked
      ) {
        setMode(input.dataset.themeMode);
      }
    });

    systemTheme.addEventListener('change', () => {
      if (mode === 'system') applyTheme();
    });

    window.addEventListener('storage', (event) => {
      if (event.key === null || event.key === 'theme' || event.key === 'theme-system') {
        mode = readMode();
        applyTheme();
      }
    });

    window.addEventListener('pageshow', (event) => {
      if (event.persisted) {
        mode = readMode();
        applyTheme();
      }
    });
  })();
</script>
