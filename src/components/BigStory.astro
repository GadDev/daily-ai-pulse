---
interface Props {
  title: string;
  description: string;
  href: string;
  image: string;
  imageAlt: string;
  label?: string;
}

const {
  title,
  description,
  href,
  image,
  imageAlt,
  label = 'BIG STORY',
} = Astro.props;
---

<article class="big-story-card">
  <div class="big-story-copy">
    <p class="label">{label}</p>
    <h1><a href={href}>{title}</a></h1>
    <p class="description">{description}</p>
    <a class="read-link" href={href}>Read the story <span aria-hidden="true">→</span></a>
  </div>
  <a class="big-story-media" href={href} aria-label={`Read ${title}`}>
    <img src={image} alt={imageAlt} loading="eager" />
  </a>
</article>

<style>
  .big-story-card{
    display:grid;
    grid-template-columns:minmax(0,1fr) minmax(0,1fr);
    min-height:390px;
    margin-top:4.2rem;
    background:var(--surface);
    border:1px solid rgba(23,23,21,.05);
    border-radius:8px;
    overflow:hidden;
  }
  .big-story-copy{display:flex;flex-direction:column;justify-content:center;padding:clamp(2rem,4vw,3.4rem)}
  .label{margin:0 0 1.25rem;font-weight:700;color:var(--ink)}
  h1{font-family:Georgia,'Times New Roman',serif;font-size:clamp(2.5rem,5vw,4.5rem);line-height:.98;letter-spacing:-.045em;margin:0;max-width:10ch}
  h1 a{text-decoration:none}
  .description{max-width:34rem;margin:1.35rem 0 0;font-size:1rem;line-height:1.55;color:var(--ink-muted)}
  .read-link{align-self:flex-start;margin-top:1.45rem;padding:.8rem 1.05rem;border-radius:5px;background:var(--ink);color:var(--surface);text-decoration:none;font-size:.82rem;font-weight:700}
  .big-story-media{display:block;min-height:100%}
  img{display:block;width:100%;height:100%;min-height:390px;object-fit:cover}
  @media(max-width:760px){
    .big-story-card{grid-template-columns:1fr;margin-top:2.4rem}
    .big-story-media{order:-1}
    img{min-height:260px;max-height:360px}
    h1{max-width:14ch}
  }
</style>
