---
interface Props {
  index?: number;
  label: string;
  title: string;
  description?: string;
  href: string;
  meta?: string;
  // Edition (archive) layout: setting `day` switches from the story-row layout.
  day?: number;
  fullDate?: string;
  storyCount?: number;
  desks?: string[];
}

const {
  index = 0,
  label,
  title,
  description,
  href,
  meta,
  day,
  fullDate,
  storyCount,
  desks,
} = Astro.props;
const isEdition = day !== undefined;
---

{isEdition ? (
  <article class="edition-row">
    <span class="day" aria-hidden="true">
      {day}
    </span>
    <p class="label" aria-hidden="true">
      {label}
    </p>
    <h2>
      <a href={href}>
        <span class="sr-only">{fullDate}: </span>
        {title}
      </a>
    </h2>
    <div class="edition-meta">
      <p class="stories">
        {storyCount} {storyCount === 1 ? 'story' : 'stories'}
      </p>
      {desks && desks.length > 0 && <p class="desks">{desks.join(' · ')}</p>}
    </div>
    <span class="arrow" aria-hidden="true">
      →
    </span>
  </article>
) : (
  <article class="issue-row">
    <span class="index">{String(index).padStart(2, '0')}</span>
    <div class="content">
      <p class="label">{label}</p>
      <h2>
        <a href={href}>{title}</a>
      </h2>
      <p>{description}</p>
    </div>
    {meta && <p class="meta">{meta}</p>}
  </article>
)}

<style>
  .issue-row {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto;
    gap: 1.4rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--line);
    align-items: start;
  }
  .index {
    font:
      600 0.72rem/1 ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;
    color: var(--ink-muted);
  }
  h2 {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1.45rem, 3vw, 2rem);
    line-height: 1.05;
    margin: 0.35rem 0 0.55rem;
  }
  h2 a {
    text-decoration: none;
  }
  .content > p:not(.label) {
    margin: 0.25rem 0;
    color: var(--ink-muted);
    line-height: 1.5;
    max-width: 60ch;
  }

  .edition-row {
    position: relative;
    display: grid;
    grid-template-columns: 5.5rem 7rem minmax(0, 1fr) minmax(14rem, 19rem) 2rem;
    grid-template-areas: 'day label title meta arrow';
    align-items: stretch;
    column-gap: 1.5rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--line);
    min-height: 44px;
  }
  .edition-row:hover {
    background: var(--surface);
  }
  .day {
    grid-area: day;
    display: flex;
    align-items: center;
    padding-right: 1.5rem;
    border-right: 1px solid var(--line);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2.4rem, 5vw, 3.4rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: lining-nums;
  }
  .edition-row .label {
    grid-area: label;
    align-self: center;
    margin: 0;
    color: var(--muted);
    letter-spacing: 0.16em;
    white-space: nowrap;
  }
  .edition-row h2 {
    grid-area: title;
    align-self: center;
    margin: 0;
    max-width: 28ch;
    font-size: clamp(1.2rem, 2.2vw, 1.55rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  /* Stretched link: the whole row is one 44px+ target. */
  .edition-row h2 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .edition-row h2 a:focus-visible {
    outline: none;
  }
  .edition-row h2 a:focus-visible::after {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .edition-row:hover h2 a,
  .edition-row h2 a:focus-visible {
    text-decoration: underline;
    text-decoration-color: var(--terracotta);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }
  .edition-meta {
    grid-area: meta;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.45rem;
    padding-left: 1.5rem;
    border-left: 1px solid var(--line);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .edition-meta p {
    margin: 0;
  }
  .stories {
    font-weight: 700;
  }
  .desks {
    color: var(--muted);
  }
  .arrow {
    grid-area: arrow;
    align-self: center;
    justify-self: end;
    color: var(--terracotta);
    font-size: 1.5rem;
    line-height: 1;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 960px) {
    .edition-row {
      grid-template-columns: 4.5rem 6rem minmax(0, 1fr) 2rem;
      grid-template-areas:
        'day label title arrow'
        'day label meta arrow';
      row-gap: 0.6rem;
    }
    .edition-meta {
      padding-left: 0;
      border-left: 0;
    }
  }
  @media (max-width: 680px) {
    .issue-row {
      grid-template-columns: 2.25rem 1fr;
    }
    .meta {
      grid-column: 2;
    }
    .edition-row {
      grid-template-columns: 3.5rem minmax(0, 1fr) 1.5rem;
      grid-template-areas:
        'day label arrow'
        'day title arrow'
        'day meta arrow';
      column-gap: 1rem;
      row-gap: 0.35rem;
    }
    .day {
      padding-right: 1rem;
      align-items: flex-start;
    }
  }
</style>
