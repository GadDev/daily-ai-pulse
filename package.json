{
  "name": "pulse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "content:check": "node scripts/validate-content.mjs",
    "editorial:check": "node scripts/validate-editorial-batch.mjs",
    "illustration:check": "node scripts/validate-illustration-batch.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --write scripts/build-illustration-contact-sheet.mjs scripts/validate-illustration-batch.mjs && git diff --exit-code -- scripts/build-illustration-contact-sheet.mjs scripts/validate-illustration-batch.mjs",
    "build": "npm run check && astro build && pagefind --site dist",
    "verify": "npm run lint && npm run format:check && npm run content:check && npm run editorial:check && npm run illustration:check && npm run build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/mdx": "8.0.2",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.5",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "eslint": "10.10.0",
    "pagefind": "1.5.2",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0"
  }
}
