---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DailyIssueRow from '../../components/DailyIssueRow.astro';
import { buildPulseArchive } from '../../lib/pulse-archive';

const base = import.meta.env.BASE_URL;
const months = buildPulseArchive(await getCollection('pulse'), await getCollection('stories'));
---

<BaseLayout
  title="The Pulse archive — Daily AI editions"
  description="Browse every Daily AI Pulse edition, newest first."
>
  <header class="archive-head">
    <p class="eyebrow">The back issues</p>
    <h1>The Pulse archive</h1>
    <p class="dek">Every curated edition, newest first.</p>
  </header>

  {months.length > 0 ? (
    months.map((month) => (
      <section class="archive-month" aria-labelledby={`month-${month.key}`}>
        <h2 class="month-heading" id={`month-${month.key}`}>
          {month.label} · {month.editionCount} {month.editionCount === 1 ? 'edition' : 'editions'}
        </h2>
        <div class="issue-list">
          {month.rows.map((row) => (
            <DailyIssueRow
              day={row.day}
              label={row.weekdayMonth}
              fullDate={row.fullDate}
              title={row.title}
              href={`${base}pulse/${row.id}/`}
              storyCount={row.storyCount}
              desks={row.desks}
            />
          ))}
        </div>
      </section>
    ))
  ) : (
    <p class="empty-state">No Pulse editions have been published yet.</p>
  )}
</BaseLayout>

<style>
  .archive-head {
    padding: 2.4rem 0 2.2rem;
  }
  .eyebrow {
    margin: 0;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--terracotta);
  }
  h1 {
    margin: 0.5rem 0 0.4rem;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(3rem, 8vw, 5.5rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.045em;
  }
  .dek {
    margin: 0;
    color: var(--muted);
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    font-family: Georgia, 'Times New Roman', serif;
    line-height: 1.3;
  }
  .archive-month + .archive-month {
    margin-top: 3rem;
  }
  .month-heading {
    margin: 0;
    padding: 1rem 0;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--line);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 0.78rem;
    font-weight: 00;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .empty-state {
    margin: 2rem 0;
    color: var(--muted);
  }
</style>
