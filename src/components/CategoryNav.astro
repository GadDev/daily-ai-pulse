---
const categories = [
  ['Research', 'research'],
  ['Models', 'models'],
  ['AI Engineering', 'engineering'],
  ['Dev Tools', 'tools'],
  ['AI in Practice', 'practice'],
  ['Workflows', 'workflows'],
  ['Business & Industry', 'business'],
  ['Curious AI', 'curious'],
] as const;

interface Props {
  active?: string;
}

const { active } = Astro.props;
---

<nav class="category-nav" aria-label="Categories" tabindex="0">
  <a
    class:list={{ active: !active }}
    href={`${import.meta.env.BASE_URL}categories/`}
    aria-current={!active ? 'page' : undefined}
  >
    All
  </a>
  {categories.map(([label, slug]) => (
    <a
      class:list={{ active: active === slug }}
      href={`${import.meta.env.BASE_URL}${slug}/`}
      aria-current={active === slug ? 'page' : undefined}
    >
      {label}
    </a>
  ))}
</nav>

<style>
  .category-nav {
    display: flex;
    gap: clamp(1.25rem, 3vw, 2.6rem);
    overflow-x: auto;
    border-bottom: 1px solid var(--line);
    scrollbar-width: none;
  }
  .category-nav::-webkit-scrollbar {
    display: none;
  }
  .category-nav:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  /* auto margins center the strip when it fits and keep the start reachable when it scrolls */
  a:first-child {
    margin-left: auto;
  }
  a:last-child {
    margin-right: auto;
  }
  a {
    display: inline-flex;
    align-items: center;
    flex: none;
    min-height: 44px;
    padding: 0 0.15rem;
    white-space: nowrap;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--ink-muted);
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
  }
  a:hover {
    color: var(--ink);
  }
  a.active {
    color: var(--terracotta);
    border-bottom-color: var(--terracotta);
  }
  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
</style>
