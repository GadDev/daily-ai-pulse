---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import StoryListRow from '../../components/StoryListRow.astro';

const base = import.meta.env.BASE_URL;
const stories = (await getCollection('stories'))
  .filter((story) => story.data.category === 'practice')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title="AI in Practice — Pulse"
  description="Real engineering and business case studies for applied AI."
>
  <section class="issue-head">
    <p class="eyebrow">CATEGORY ARCHIVE</p>
    <h1>AI in Practice</h1>
    <p>Real engineering and business case studies for applied AI.</p>
  </section>

  <CategoryNav active="practice" />

  <section class="archive-list">
    <SectionHeading title="Latest case studies" />
    {stories.map((story) => (
      <StoryListRow
        title={story.data.title}
        description={story.data.description}
        href={`${base}stories/${story.id}/`}
        date={story.data.date.toLocaleDateString('en-GB')}
        meta={`${story.data.type} · ${story.data.difficulty} · evidence/${story.data.evidence} · signal/${story.data.signal}`}
      />
    ))}
  </section>
</BaseLayout>

<style>
  .archive-list {
    padding: 3rem 0 1rem;
  }
</style>
