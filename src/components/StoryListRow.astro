---
interface Props {
  title: string;
  description: string;
  href: string;
  date: string;
  meta?: string;
}

const { title, description, href, date, meta } = Astro.props;
---

<article class="story-list-row">
  <div>
    <h2><a href={href}>{title}</a></h2>
    <p>{description}</p>
  </div>
  <div class="details">
    <time>{date}</time>
    {meta && <span>{meta}</span>}
  </div>
</article>

<style>
  .story-list-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:2rem;padding:1.5rem 0;border-top:1px solid var(--line)}
  h2{font-family:Georgia,'Times New Roman',serif;font-size:1.65rem;line-height:1.05;margin:0 0 .55rem}
  h2 a{text-decoration:none}
  p{margin:0;max-width:62ch;color:var(--ink-muted);line-height:1.5}
  .details{display:grid;gap:.4rem;align-content:start;text-align:right;font-size:.76rem;color:var(--ink-muted)}
  @media(max-width:640px){.story-list-row{grid-template-columns:1fr}.details{text-align:left}}
</style>
