---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BigStory from '../components/BigStory.astro';
import StoryCard from '../components/StoryCard.astro';
import LatestPulseList from '../components/LatestPulseList.astro';
import {
  categoryLabel,
  evidenceLabel,
  formatDate,
  readingTime,
  storyCount,
  storyImage,
  storyUrl,
} from '../lib/editorial';

type Story = CollectionEntry<'stories'>;
const base = import.meta.env.BASE_URL;
const stories = (await getCollection('stories')).filter((story) => !story.data.draft);
const editions = (await getCollection('pulse')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const edition = editions[0];
const storyById = new Map(stories.map((story) => [story.id, story]));
const selected = edition
  ? [...new Set(edition.data.sections.flatMap((section) => section.stories))]
      .map((id) => storyById.get(id))
      .filter((story): story is Story => Boolean(story))
  : [];
const featured = edition ? storyById.get(edition.data.featured) : undefined;
const lead = featured ?? selected[0];
const supporting = selected
  .filter((story) => story.id !== lead?.id)
  .sort((a, b) => Number(b.data.category === 'research') - Number(a.data.category === 'research'));
const recent = editions.slice(0, 3).map((item) => ({
  date: item.data.date,
  title: item.data.summary,
  href: `${base}pulse/${item.id}/`,
  count: storyCount(item),
}));
---

<BaseLayout title="The Daily AI Pulse — Signal over noise in AI">
  {edition && (
    <div class="edition-rail">
      <time datetime={edition.data.date.toISOString()}>
        {formatDate(edition.data.date, {
          weekday: 'long',
          day: 'numeric',
          month: 'long',
          year: 'numeric',
        })}
      </time>
      <a href={`${base}pulse/${edition.id}/`}>Today's edition ↗</a>
      <span>{storyCount(edition)} selected stories</span>
    </div>
  )}

  {lead && (
    <BigStory
      title={lead.data.title}
      description={lead.data.description}
      href={storyUrl(lead)}
      image={storyImage(lead)}
      imageAlt={lead.data.imageAlt}
      category={categoryLabel(lead)}
      evidence={evidenceLabel(lead)}
      readingTime={readingTime(lead)}
    />
  )}

  {supporting.length > 0 && (
    <section class="home-section" aria-labelledby="signal-title">
      <div class="section-intro">
        <p class="eyebrow">SELECTED FROM THE EDITION</p>
        <h2 id="signal-title">Today's signal</h2>
      </div>
      <div class="signal-grid">
        {supporting.map((story, index) => (
          <StoryCard
            label={categoryLabel(story)}
            title={story.data.title}
            description={story.data.description}
            href={storyUrl(story)}
            image={index === 0 ? storyImage(story) : undefined}
            imageAlt={story.data.imageAlt}
            meta={`${evidenceLabel(story)} · ${readingTime(story)}`}
          />
        ))}
      </div>
      <a class="section-link" href={`${base}pulse/${edition?.id}/`}>
        Read the full edition →
      </a>
    </section>
  )}

  {recent.length > 0 && <LatestPulseList items={recent} />}

  <aside class="home-follow">
    <div>
      <p class="eyebrow">STAY IN THE LOOP</p>
      <h2>One useful briefing at a time.</h2>
      <p>Follow the feed now; email delivery is planned.</p>
    </div>
    <a class="subscribe-button" href={`${base}subscribe/`}>
      Follow with RSS →
    </a>
  </aside>
</BaseLayout>

<style>
  .edition-rail {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.7rem 1.5rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.75rem;
  }
  .edition-rail a {
    color: var(--ink);
    text-decoration: none;
    font-weight: 700;
  }
  .home-section {
    padding: 2.7rem 0 4rem;
    border-bottom: 1px solid var(--line);
  }
  .section-intro {
    margin-bottom: 1.4rem;
  }
  .section-intro h2,
  .home-follow h2 {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2rem, 3.5vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
    margin: 0.35rem 0;
  }
  .signal-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(1.5rem, 4vw, 4rem);
  }
  .signal-grid :global(.story-card + .story-card) {
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .section-link {
    display: inline-block;
    margin-top: 1rem;
    text-underline-offset: 0.25em;
    font-size: 0.9rem;
  }
  .home-follow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    margin: 2rem 0 1rem;
    padding: 2rem;
    background: var(--surface);
  }
  .home-follow p:last-child {
    color: var(--muted);
    margin: 0;
  }
  @media (max-width: 700px) {
    .signal-grid {
      grid-template-columns: 1fr;
    }
    .home-follow {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
