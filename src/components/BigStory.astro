---
interface Props {
  title: string;
  description: string;
  href: string;
  image: string;
  imageAlt: string;
  label?: string;
  category?: string;
  evidence?: string;
  readingTime?: string;
}

const {
  title,
  description,
  href,
  image,
  imageAlt,
  label = 'THE BIG STORY',
  category,
  evidence,
  readingTime,
} = Astro.props;
---

<article class="big-story-card">
  <div class="big-story-copy">
    <p class="label">{label}</p>
    <h1>
      <a href={href}>{title}</a>
    </h1>
    <p class="description">{description}</p>
    <p class="story-facts">
      {category && <span>{category}</span>}
      {evidence && <span>{evidence}</span>}
      {readingTime && <span>{readingTime}</span>}
    </p>
    <a class="read-link" href={href}>
      Read the story <span aria-hidden="true">↗</span>
    </a>
  </div>
  <a class="big-story-media" href={href} aria-label={`Read ${title}`}>
    <img src={image} alt={imageAlt} loading="eager" />
  </a>
</article>

<style>
  .big-story-card {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding: clamp(2.4rem, 5vw, 4.5rem) 0;
    border-bottom: 1px solid var(--line);
  }
  .big-story-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0;
  }
  .label {
    margin: 0 0 1rem;
    font-weight: 700;
    color: var(--ink);
  }
  h1 {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2.65rem, 5vw, 5rem);
    line-height: 0.99;
    letter-spacing: -0.045em;
    margin: 0;
    max-width: 18ch;
  }
  h1 a {
    text-decoration: none;
  }
  .description {
    max-width: 34rem;
    margin: 1.35rem 0 0;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--ink-muted);
  }
  .story-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.1rem;
    margin: 1.1rem 0 0;
    color: var(--muted);
    font-size: 0.76rem;
  }
  .story-facts span + span::before {
    content: '·';
    margin-right: 1.1rem;
  }
  .read-link {
    align-self: flex-start;
    margin-top: 1.4rem;
    text-decoration: underline;
    text-underline-offset: 0.25em;
    font-size: 0.88rem;
    font-weight: 600;
  }
  .big-story-media {
    display: block;
    aspect-ratio: 1.35;
    background: var(--surface);
  }
  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (max-width: 760px) {
    .big-story-card {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 2.4rem 0;
    }
    img {
      aspect-ratio: 1.7;
    }
    h1 {
      max-width: 20ch;
    }
  }
</style>
