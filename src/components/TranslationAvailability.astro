---
const base = import.meta.env.BASE_URL;
---

<aside
  class="translation-availability"
  aria-label="Translation availability"
  data-pagefind-ignore="all"
>
  <p>
    No current French translation.{' '}
    <a href={`${base}fr/`} hreflang="fr">
      Browse the French selection
    </a>
    .
  </p>
</aside>
<style>
  .translation-availability {
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.6;
  }
  p {
    margin: 0;
  }
  a {
    color: var(--terracotta);
    text-underline-offset: 0.2em;
  }
</style>
