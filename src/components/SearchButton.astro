---
const base = import.meta.env.BASE_URL;
---

<a class="search-button" href={`${base}search/`} aria-label="Search Pulse">
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="11" cy="11" r="6.5"></circle>
    <path d="m16 16 4 4"></path>
  </svg>
</a>

<style>
  .search-button {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 0;
    background: transparent;
    color: var(--ink);
    border-radius: 999px;
    cursor: pointer;
    text-decoration: none;
  }
  svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
  }
  .search-button:hover,
  .search-button:focus-visible {
    background: var(--surface-alt);
  }
</style>
