---
import { messages, type Locale } from '../lib/i18n';
interface Props {
  locale?: Locale;
}
const text = messages[Astro.props.locale ?? 'en'];
const base = import.meta.env.BASE_URL;
const isCurrent = Astro.url.pathname === `${base}search/`;
---

<a
  class:list={['search-button', { current: isCurrent }]}
  href={`${base}search/`}
  aria-label={text.searchLabel}
  title={text.searchLabel}
  aria-current={isCurrent ? 'page' : undefined}
>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="11" cy="11" r="6.5"></circle>
    <path d="m16 16 4 4"></path>
  </svg>
  {Astro.props.locale === 'fr' && (
    <span class="search-language" aria-hidden="true">
      EN
    </span>
  )}
</a>

<style>
  .search-language {
    position: absolute;
    right: 1px;
    bottom: 2px;
    font:
      500 0.5rem/1 ui-monospace,
      monospace;
  }
  .search-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--muted);
    border-radius: 50%;
    text-decoration: none;
    flex: 0 0 auto;
  }
  svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
  }
  .search-button:hover,
  .search-button.current {
    color: var(--ink);
    background: var(--surface-alt);
  }
  .search-button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
