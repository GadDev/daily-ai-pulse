---
interface Props {
  action?: string;
  compact?: boolean;
}

const { action = '#', compact = true } = Astro.props;
---

<form class:list={['newsletter-form', { compact }]} action={action} method="post">
  <label for="pulse-email">Get the daily AI Pulse in your inbox.</label>
  <div class="controls">
    <input id="pulse-email" name="email" type="email" autocomplete="email" placeholder="you@email.com" required />
    <button type="submit">Subscribe</button>
  </div>
</form>

<style>
  .newsletter-form{display:grid;gap:.65rem;max-width:28rem}
  label{font-size:.92rem;color:var(--ink-muted)}
  .controls{display:flex;gap:.5rem}
  input{min-width:0;flex:1;border:1px solid var(--line);background:var(--surface);color:var(--ink);border-radius:999px;padding:.72rem .9rem;font:inherit}
  button{border:0;border-radius:999px;background:var(--accent);color:var(--surface);padding:.72rem 1rem;font:700 .86rem/1 inherit;cursor:pointer}
  @media(max-width:480px){.controls{flex-direction:column}button{width:100%}}
</style>
