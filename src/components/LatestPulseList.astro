---
interface Item {
  date: Date;
  title: string;
  href: string;
  count: number;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
const formatter = new Intl.DateTimeFormat('en-GB', {
  weekday: 'short',
  month: 'short',
  timeZone: 'UTC',
});
---

<section class="latest-pulse" aria-labelledby="latest-pulse-title">
  <div class="section-heading">
    <h2 id="latest-pulse-title">Recent editions</h2>
    <a href={`${import.meta.env.BASE_URL}pulse/`}>
      Browse all editions <span aria-hidden="true">→</span>
    </a>
  </div>
  <ol>
    {items.map((item) => (
      <li>
        <time datetime={item.date.toISOString()}>
          <strong>{item.date.getUTCDate()}</strong>
          <small>{formatter.format(item.date)}</small>
        </time>
        <a href={item.href}>
          <span>{item.title}</span>
          <small>
            {item.count} {item.count === 1 ? 'story' : 'stories'}
          </small>
        </a>
        <span aria-hidden="true">↗</span>
      </li>
    ))}
  </ol>
</section>

<style>
  .latest-pulse {
    padding: 3rem 0 4.5rem;
  }
  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  h2 {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2rem, 3.5vw, 3rem);
    letter-spacing: -0.025em;
    margin: 0;
  }
  .section-heading > a {
    font-size: 0.78rem;
    text-decoration: none;
    color: var(--ink-muted);
  }
  ol {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--line);
  }
  li {
    display: grid;
    grid-template-columns: 7rem 1fr auto;
    gap: 1.25rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--line);
    align-items: center;
  }
  time {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    color: var(--ink-muted);
  }
  time strong {
    font:
      2.4rem/1 Georgia,
      'Times New Roman',
      serif;
    color: var(--ink);
  }
  small {
    display: block;
    font-size: 0.72rem;
    color: var(--muted);
  }
  li > a {
    text-decoration: none;
    display: grid;
    gap: 0.45rem;
    max-width: 68ch;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1.1rem, 1.8vw, 1.45rem);
    line-height: 1.2;
  }
  li > a small {
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
  }
  @media (max-width: 620px) {
    li {
      grid-template-columns: 5rem 1fr;
      gap: 0.7rem;
    }
    li > span {
      display: none;
    }
    .section-heading {
      align-items: center;
    }
  }
</style>
